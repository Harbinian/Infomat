# 复制本文件为 .env 后填写。.env 已被 .gitignore 排除，不要提交。

# ---- Slack 凭据（从 api.slack.com 的 App 配置页获取）----
# Bot User OAuth Token，xoxb- 开头
SLACK_BOT_TOKEN=xoxb-your-bot-token
# App-Level Token，xapp- 开头，需要 connections:write scope
SLACK_APP_TOKEN=xapp-your-app-token

# ---- 模型通道 ----
# 复用本机 Claude Code 的 DeepSeek 兼容端点；若本机已设系统环境变量可留空
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=your-deepseek-api-key
ANTHROPIC_MODEL=deepseek-flash[1m]

# ---- 网络代理 ----
# 关键：Socket Mode 的 WebSocket 走 npm 版 undici，不读 HTTP_PROXY/HTTPS_PROXY，
# 必须显式告知。留空时会依次回退到 HTTPS_PROXY / HTTP_PROXY（含小写写法）。
BOT_PROXY=http://127.0.0.1:7892

# ---- 机器人行为 ----
# 只读问答的可读目录（默认指向本仓库根目录）
BOT_WORKDIR=E:/CA001/Infomat
# 每次提问的预算上限（美元，按 CLI 的估算口径，非 DeepSeek 实际计费）
BOT_MAX_BUDGET_USD=0.5
# 单次回答超时（毫秒）。需要全仓库检索的问题实测可跑 4~5 分钟，不要设得太短。
BOT_TIMEOUT_MS=600000
# 同时处理的问题数上限
BOT_MAX_CONCURRENT=3

# ---- 访问控制（留空 = 工作区内所有人可用）----
# 逗号分隔的 Slack 用户 ID，例如 U01ABC2DEF3,U04GHI5JKL6
BOT_ALLOWED_USERS=
# 逗号分隔的频道 ID，例如 C01ABC2DEF3
BOT_ALLOWED_CHANNELS=

# ---- 写入权限（留空 = 所有人只读，这是安全默认值）----
# 只有列在这里的 Slack 用户 ID 能拿到写入档，其余人一律只读。
# 查自己的 ID：Slack 里点自己头像 -> 个人资料 -> 右上角 ... -> 复制成员 ID
BOT_WRITE_USERS=
# 写入档的可用工具。默认 Read,Grep,Glob,Edit,Write —— 能改文件但不能执行命令。
#
# 加上 Bash 后可以跑命令和 git（镜像里已装 git 并配好 safe.directory）。
# 但要知道：CLI 自带的命令过滤只是模式匹配，换个写法就能绕过
# （实测同一条 rm -rf，带 && 链式写法被拒，去掉 && 就放行）。
# 所以开 Bash 等于把工作区的完整操作权交出去——动手前先 git stash 或 commit 存档。
BOT_WRITE_TOOLS=Read,Grep,Glob,Edit,Write
