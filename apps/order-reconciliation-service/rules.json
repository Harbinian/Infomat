    "crossSourceSnapshot": "read-windows-not-a-single-instant"
  },
  "responsibility": "not-required-for-first-inventory",
  "evidenceLimit": "snapshot differences do not prove actor, exact modification time or cause",
  "quantityReview": {
    "enabled": true,
    "version": 2,
    "historyPolicy": "order-adopted-bom-and-explicit-change-scope",
