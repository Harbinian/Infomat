    "publication": "same-batch-atomic",
    "retention": "immutable-batch-files-and-report"
  },
  "materialChecks": {
    "enabled": true,
    "version": 1,
    "historyPolicy": "order-adopted-bom-and-explicit-change-scope",
    "confirmation": "current-record-facts-only",
    "publication": "same-batch-atomic",
    "retention": "append-only-with-separate-supplement-provenance"
  },
  "orderChecks": {
    "enabled": true,
    "version": 1,
    "confirmation": "corresponding-record-numeric-difference-only",
    "history": "append-only-no-recalculation",
    "publication": "same-batch-atomic"
  },
  "chainChecks": {
    "enabled": true,
    "version": 1,
    "confirmation": "current-record-conflict-only",
