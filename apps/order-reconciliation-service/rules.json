    "publication": "same-batch-atomic",
    "sla": "not-defined",
    "exceptions": "explicit-applicability-evidence-only",
    "confirmation": "current-record-gap-only",
    "actions": "read-only-no-voucher"
  },
  "unifiedStatistics": {
    "enabled": true,
    "version": 1,
    "policy": "review-priority-v1",
    "publication": "same-batch-atomic",
    "history": "append-only-no-recalculation",
    "actions": "read-only-no-unlock-no-voucher",
    "persistence": {
