    "mesIntermediate": "u8autoid+u8id plus scoped task or KFU source composite evidence",
    "mesTraveler": "scoped task production number plus U8 part number within that sales source; unique matches only"
  },
  "execution": {
    "anyRequiredReadFailure": "fail-entire-batch",
    "publish": "atomic-after-all-source-reads-and-local-persistence",
