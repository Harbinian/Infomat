{
  "version": "full-inventory-20261112-v8",
  "scope": {
    "account": "333",
    "u8Database": "UFDATA_333_2025",
    "approvedSales": "SO_SOMain.iStatus=1 and nonblank cVerifier",
    "productionStatuses": [
      3,
      4
    ],
    "historicalScope": "all existing records in the selected current databases, without date or closed-order exclusion"
