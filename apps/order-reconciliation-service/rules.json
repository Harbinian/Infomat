  "qualityNumber": {
    "comparison": "raw-exact",
    "normalization": "none",
    "semanticEquivalence": "not-yet-defined",
    "nullFallback": false
  },
  "identity": {
    "numericReferences": "integer parsing for technical IDs only; raw evidence retained",
    "mesLocalProductionNumber": "distinct from U8 production number"
  },
  "association": {
    "salesToProduction": "OrderType=1, OrderDId=iSOsID; verify OrderCode if present",
