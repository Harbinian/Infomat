      // ===== 全局配置 =====
      var systemBasis = {
        "OA": "适用于申请审批、通知传阅、绩效任务、会议纪要、沟通记录、合同审签、制度文件流转和闭环留痕。",
        "MES": "适用于生产订单、外协外包执行状态、现场检验/接收、工时与工序执行数据、设备验收投用及可采集的现场过程数据。",
        "PLM": "适用于图纸、数模、工艺文件、技术方案、技改项目资料、工程更改和工作转移技术资料协同。",
        "ERP": "适用于客户、供应商、采购、销售订单、合同、价格、库存、固定资产、结算、应收应付和财务落账。"
      };

      var domainColors = {
        "工装需求与设计管理": "#2563eb",
        "工装验收与验证管理": "#0891b2",
        "工装运行管理": "#16a34a",
        "工具管理": "#d97706",
        "物资库房与备件管理": "#7c3aed",
        "体系与信息化支撑": "#dc2626"
};

      var compactDomainLabels = {
        "工装需求与设计管理": "工装需求\n设计管理",
        "工装验收与验证管理": "工装验收\n验证管理",
        "工装运行管理": "工装运行管理",
        "工具管理": "工具管理",
        "物资库房与备件管理": "物资库房\n备件管理",
        "体系与信息化支撑": "体系与信息化支撑"
};

      var systemColors = {
        OA: "#38bdf8",
        MES: "#8b5cf6",
        PLM: "#22c55e",
        ERP: "#fb923c"
      };

      var active = "全域总览";
      var chartLayout = "horizontal";
      var domains = Array.from(new Set(l3Rows.map(function(r) { return r.domain; })));
      var chart;

      // ===== 工具函数 =====
      function esc(value) {
        var entities = {"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"};
        return String(value == null ? "" : value).replace(/[&<>"']/g, function(c) { return entities[c]; });
      }

      function systemsFor(sysStr) {
        return String(sysStr || "").split("、").map(function(s) { return s.trim(); }).filter(Boolean);
      }

      function colorFor(name) {
        if (name === "物资保障部") return "#3b82f6";
        if (domainColors[name]) return domainColors[name];
        if (systemColors[name]) return systemColors[name];
        return "#64748b";
      }

      function apprClass(type) {
        if (type === "无审批") return "none";
        if (type === "单人审批") return "single";
        if (type === "多级审批") return "multi";
        if (type === "会签") return "cosign";
        return "none";
      }

      function shortText(value, max) {
        var text = String(value || "");
        return text.length > max ? text.slice(0, max - 1) + "…" : text;
      }

      function isCollectiveRole(role) {
        var text = String(role || "").trim();
        if (!text) return true;
        if (/(专员|主管|经理|负责人|管理员|经办人|工程师|审核人|审批人|填报人)$/.test(text)) return false;
        return /(部|部门|办公室|中心|小组|委员会|团队)$/.test(text);
      }

      function roleWarning(a1) {
        return isCollectiveRole(a1[2]) ? "请部门确认具体岗位/责任人：当前为部门/组织" : "";
      }

      function isFinalStep(a1) {
        var proc = a1[11];
        var rows = a1Rows.filter(function(r) { return r[11] === proc; });
        return rows.length > 0 && rows[rows.length - 1][0] === a1[0];
      }

      function isTrackingTask(a1) {
        return /(跟踪|进度|监测|监督|闭环|催办|提醒|进展|看板|预警)/.test([a1[1], a1[3], a1[11]].join(""));
      }

      function requiresAcceptance(a1) {
        return a1[5] === "无审批" && isFinalStep(a1);
      }

      function acceptanceWarning(a1) {
        return requiresAcceptance(a1) ? "请部门确认是否需要验收/完成标准" : "";
      }

      function evidenceWarning(a1) {
        return a1[8] === "原文明确-正文" ? "请部门确认依据类型：正文/流程图/表单，并核对角色、触发、前置条件" : "";
      }

      function evidenceClass(type) {
        return /^原文明确-(正文|流程图|表单)$/.test(String(type || "")) ? "explicit" : "inferred";
      }

      function auditWarnings(a1) {
        return [roleWarning(a1), acceptanceWarning(a1), evidenceWarning(a1), trackingNote(a1)].filter(Boolean);
      }

      function warningHtml(a1) {
        return auditWarnings(a1).map(function(w) {
          var strong = w.indexOf("具体岗位") >= 0 || w.indexOf("验收") >= 0;
          return '<span class="' + (strong ? "warn-tag" : "soft-warn-tag") + '">' + esc(w) + '</span>';
        }).join("");
      }

      function acceptanceText(a1) {
        if (requiresAcceptance(a1)) return "待补：关口验收/完成标准需核验";
        if (a1[5] === "无审批" && isTrackingTask(a1)) return "不适用：跟踪类过程，由系统待办/进度展示承载";
        if (a1[5] === "无审批") return "不适用：过程环节";
        return "审批流控制";
      }

      function trackingNote(a1) {
        return isTrackingTask(a1) ? "跟踪类任务：建议由系统待办提醒、到期预警或进度展示承载" : "";
      }

      function a1DisplayLabel(a1) {
        var role = roleWarning(a1) ? "待确认：" + a1[2] : a1[2];
        return shortText(a1[1], 18) + "\n" + shortText(role, 18);
      }

      function processFill(proc) {
        var hash = 0;
        String(proc || "").split("").forEach(function(ch) {
          hash = (hash * 31 + ch.charCodeAt(0)) >>> 0;
        });
        var hue = hash % 360;
        return "hsl(" + hue + " 75% 97%)";
      }

      // ===== 数据过滤 =====
      function filteredA1() {
        if (active === "全域总览") return [];
        return a1Rows.filter(function(r) { return r[9] === active; });
      }

      function filteredL3() {
        if (active === "全域总览") return l3Rows;
        return l3Rows.filter(function(r) { return r.domain === active; });
      }

      // ===== 构建桑基图 =====
      function buildGraph() {
        var nodeMap = new Map();
        var links = [];

        function addNode(name, options) {
          if (!nodeMap.has(name)) {
            var node = { name: name, itemStyle: { color: colorFor(name) } };
            if (options) {
              Object.keys(options).forEach(function(k) {
                if (k === "itemStyle") {
                  node.itemStyle = Object.assign({}, node.itemStyle, options.itemStyle);
                } else {
                  node[k] = options[k];
                }
              });
            }
            nodeMap.set(name, node);
          }
        }

        function addLink(source, target, value, meta) {
          links.push({ source: source, target: target, value: value || 1, lineStyle: { color: colorFor(source), opacity: 0.42 }, meta: meta });
        }

        if (active === "全域总览") {
          addNode("物资保障部");
          filteredL3().forEach(function(row) {
            addNode(row.domain);
            addNode(row.capability);
            addLink("物资保障部", row.domain, 1, { type: "l3", row: row });
            addLink(row.domain, row.capability, 1, { type: "l3", row: row });
            systemsFor(row.system).forEach(function(sys) {
              addNode(sys);
              addLink(row.capability, sys, 1, { type: "l3", row: row });
            });
          });
        } else {
          // 域详情: 业务能力（L2） → 业务流程（L3） → 业务行为（A1） → 应用系统（S1）
          var fa = filteredA1();
          var seenProc = {};
          var seenCap = {};

          fa.forEach(function(a1) {
            var cap = a1[10], proc = a1[11], a1Id = a1[0], sys = a1[6];

            addNode(cap);
            addNode(proc);
            addNode(a1Id, {
              itemStyle: { color: roleWarning(a1) ? "#dc2626" : "#64748b" },
              label: { formatter: a1DisplayLabel(a1) }
            });

            if (!seenCap[cap]) { seenCap[cap] = true; }
            if (!seenProc[proc]) {
              seenProc[proc] = true;
              addLink(cap, proc, 1, { type: "l3", cap: cap, proc: proc });
            }
            addLink(proc, a1Id, 1, { type: "a1", a1: a1 });

            systemsFor(sys).forEach(function(s) {
              addNode(s);
              addLink(a1Id, s, 1, { type: "a1sys", a1: a1 });
            });
          });
        }

        // 合并重复连线
        var dedup = new Map();
        links.forEach(function(l) {
          var key = l.source + ">>>" + l.target;
          if (dedup.has(key)) {
            dedup.get(key).value += l.value;
          } else {
            dedup.set(key, l);
          }
        });

        return { nodes: Array.from(nodeMap.values()), links: Array.from(dedup.values()) };
      }

      // ===== 渲染图表 =====
      function renderChart() {
        var graph = buildGraph();
        var isVertical = chartLayout === "vertical";
        var isGlobal = active === "全域总览";

        document.getElementById("chartTitle").textContent = isGlobal ? "物资保障部全域总览" : active;
        document.getElementById("chartSub").textContent = isGlobal
          ? (isVertical ? "部门（D1）↓ 能力域（L1）↓ 业务能力（L2）↓ 应用系统（S1）" : "部门（D1）→ 能力域（L1）→ 业务能力（L2）→ 应用系统（S1）")
          : (isVertical ? "业务能力（L2）↓ 业务流程（L3）↓ 业务行为（A1）↓ 应用系统（S1）" : "业务能力（L2）→ 业务流程（L3）→ 业务行为（A1）→ 应用系统（S1）");

        if (!chart) { chart = echarts.init(document.getElementById("chart")); }

        chart.setOption({
          backgroundColor: "#0f172a",
          animation: false,
          tooltip: {
            trigger: "item",
            triggerOn: "mousemove",
            confine: true,
            backgroundColor: "rgba(15,23,42,.96)",
            borderColor: "#334155",
            textStyle: { color: "#e5e7eb", fontSize: 12 },
            formatter: function(params) {
              if (params.dataType === "edge") {
                var m = params.data.meta || {};
                if (m.type === "a1" || m.type === "a1sys") {
                  var a = m.a1 || [];
                  return [
                    "<b>" + esc(a[0]) + " " + esc(a[1]) + "</b>",
                    "执行角色：" + esc(a[2] || ""),
                    "触发情景：" + esc(a[3] || ""),
                    "前置条件：" + esc(a[4] || ""),
                    "审批类型：" + esc(a[5] || ""),
                    "验收标准：" + esc(acceptanceText(a)),
                    "制度依据：" + esc(a[7] || ""),
                    "证据类型：" + esc(a[8] || ""),
                    "应用系统：" + esc(a[6] || ""),
                    auditWarnings(a).length ? "部门确认：" + esc(auditWarnings(a).join("；")) : ""
                  ].filter(Boolean).join("<br>");
                }
                if (m.type === "l3" && m.row) {
                  return [
                    "<b>" + esc(params.data.source) + " → " + esc(params.data.target) + "</b>",
                    "流程：" + esc(m.row.process || ""),
                    "制度依据：" + esc(m.row.evidence || ""),
                    "系统依据：" + esc(m.row.basis || "")
                  ].join("<br>");
                }
                return "<b>" + esc(params.data.source) + " → " + esc(params.data.target) + "</b>";
              }
              // 节点 tooltip
              if (systemBasis[params.name]) {
                return "<b>" + esc(params.name) + "</b><br>" + esc(systemBasis[params.name]);
              }
              // 业务行为（A1）节点
              var a1Match = a1Rows.find(function(r) { return r[0] === params.name; });
              if (a1Match) {
                return [
                  "<b>" + esc(a1Match[0]) + " " + esc(a1Match[1]) + "</b>",
                  "角色：" + esc(a1Match[2]),
                  "触发：" + esc(a1Match[3]),
                  "前置：" + esc(a1Match[4]),
                  "审批：" + esc(a1Match[5]),
                  "验收标准：" + esc(acceptanceText(a1Match)),
                  auditWarnings(a1Match).length ? "部门确认：" + esc(auditWarnings(a1Match).join("；")) : ""
                ].filter(Boolean).join("<br>");
              }
              return "<b>" + esc(params.name) + "</b>";
            }
          },
          series: [{
            type: "sankey",
            orient: chartLayout,
            data: graph.nodes,
            links: graph.links,
            left: isVertical ? 54 : 20,
            right: isVertical ? 54 : 140,
            top: isVertical ? 34 : 16,
            bottom: isVertical ? 76 : 24,
            nodeWidth: 18,
            nodeGap: isVertical ? 10 : 12,
            draggable: true,
            emphasis: { focus: "adjacency" },
            label: {
              color: "#e5e7eb",
              fontSize: isGlobal ? (isVertical ? 11 : 12) : (isVertical ? 10 : 11),
              overflow: "break",
              position: isVertical ? "inside" : "right",
              width: isGlobal ? (isVertical ? 62 : 160) : (isVertical ? 100 : 220),
              lineHeight: isVertical ? 13 : 14,
              formatter: function(params) {
                var name = params.name;
                // 全域总览竖直模式下 L2 能力用编号
                if (isGlobal && isVertical && l3Rows.some(function(r) { return r.capability === name; })) {
                  var idx = l3Rows.findIndex(function(r) { return r.capability === name; });
                  return String(idx >= 0 ? idx + 1 : "").padStart(2, "0");
                }
                // 域详情业务行为（A1）节点显示业务行为 + 执行角色，编号保留在 tooltip 和明细表
                if (!isGlobal && a1Rows.some(function(r) { return r[0] === name; })) {
                  var a1 = a1Rows.find(function(r) { return r[0] === name; });
                  return a1DisplayLabel(a1);
                }
                // 竖直紧凑标签
                if (isVertical && compactDomainLabels[name]) return compactDomainLabels[name];
                return name;
              }
            },
            lineStyle: { curveness: 0.5, opacity: 0.38 }
          }]
        }, true);
      }

      // ===== 控件 =====
      function renderControls() {
        var bar = document.getElementById("modebar");
        bar.innerHTML = '<span class="mode-label">视图</span>';
        ["全域总览"].concat(domains).forEach(function(name) {
          var btn = document.createElement("button");
          btn.className = "mode-btn" + (name === active ? " active" : "");
          btn.textContent = name;
          btn.onclick = function() {
            active = name;
            Array.from(bar.querySelectorAll(".mode-btn")).forEach(function(b) { b.classList.toggle("active", b.textContent === name); });
            renderAll();
          };
          bar.appendChild(btn);
        });
      }

      function renderLayoutControls() {
        var bar = document.getElementById("layoutbar");
        bar.innerHTML = '<span class="mode-label">布局</span>';
        [{v:"horizontal",l:"从左到右"},{v:"vertical",l:"自上而下"}].forEach(function(lo) {
          var btn = document.createElement("button");
          btn.className = "mode-btn" + (lo.v === chartLayout ? " active" : "");
          btn.textContent = lo.l;
          btn.onclick = function() {
            chartLayout = lo.v;
            Array.from(bar.querySelectorAll(".mode-btn")).forEach(function(b) { b.classList.toggle("active", b.textContent === lo.l); });
            renderChart();
          };
          bar.appendChild(btn);
        });
      }

      // ===== 统计 =====
      function renderBars() {
        // 域规模（A1数）
        var domainA1 = {};
        a1Rows.forEach(function(r) { domainA1[r[9]] = (domainA1[r[9]] || 0) + 1; });
        var maxD = Math.max.apply(null, Object.values(domainA1));
        document.getElementById("domainBars").innerHTML = Object.keys(domainA1).map(function(d) {
          return '<div class="bar-line"><span>' + esc(d) + '</span><div class="bar-track"><div class="bar-fill" style="width:' + Math.round(domainA1[d]/maxD*100) + '%;background:' + colorFor(d) + '"></div></div><strong>' + domainA1[d] + '</strong></div>';
        }).join("");

        // 系统承载（A1参与次数）
        var sysCnt = {OA:0,MES:0,PLM:0,ERP:0};
        a1Rows.forEach(function(r) {
          systemsFor(r[6]).forEach(function(s) { if (sysCnt[s] != null) sysCnt[s] += 1; });
        });
        var maxS = Math.max.apply(null, Object.values(sysCnt));
        document.getElementById("systemBars").innerHTML = Object.keys(sysCnt).map(function(s) {
          return '<div class="bar-line"><span>' + esc(s) + '</span><div class="bar-track"><div class="bar-fill" style="width:' + Math.round(sysCnt[s]/maxS*100) + '%;background:' + systemColors[s] + '"></div></div><strong>' + sysCnt[s] + '</strong></div>';
        }).join("");
      }

      function renderLegend() {
        var dLeg = domains.map(function(d) { return '<span class="legend"><i style="background:' + domainColors[d] + '"></i>' + esc(d) + '</span>'; }).join("");
        var sLeg = Object.keys(systemColors).map(function(s) { return '<span class="legend"><i style="background:' + systemColors[s] + '"></i>' + esc(s) + '</span>'; }).join("");
        document.getElementById("legendRow").innerHTML = dLeg + sLeg;
      }

      // ===== 表格 =====
      function renderTable() {
        var isGlobal = active === "全域总览";
        var head = document.getElementById("tableHead");
        var body = document.getElementById("mappingBody");
        var tbl = document.getElementById("mappingTable");

        if (isGlobal) {
          tbl.className = "table-l3";
          head.innerHTML = '<tr><th class="col-seq">序号</th><th class="col-dept">部门（D1）</th><th class="col-domain">能力域（L1）</th><th class="col-cap">业务能力（L2）</th><th class="col-proc">业务流程（L3）</th><th class="col-evidence">制度依据</th><th class="col-system">应用系统（S1）</th><th class="col-evidence">系统设计依据</th></tr>';
          body.innerHTML = filteredL3().map(function(row, i) {
            return '<tr><td class="col-seq">' + (i+1) + '</td><td class="col-dept">物资保障部</td><td class="col-domain"><span class="domain-pill" style="background:' + colorFor(row.domain) + '">' + esc(row.domain) + '</span></td><td class="col-cap">' + esc(row.capability) + '</td><td class="col-proc">' + esc(row.process) + '</td><td class="col-evidence">' + esc(row.evidence) + '</td><td class="col-system">' + esc(row.system) + '</td><td class="col-evidence">' + esc(row.basis) + '</td></tr>';
          }).join("");
        } else {
          tbl.className = "table-a1";
          head.innerHTML = '<tr><th class="col-seq">序号</th><th class="col-a1id">业务行为（A1）编号</th><th class="col-cap">业务能力（L2）</th><th class="col-proc">业务流程（L3）</th><th class="col-a1name">业务行为（A1）</th><th class="col-role">执行角色</th><th class="col-trigger">触发情景</th><th class="col-precond">前置条件</th><th class="col-appr">审批类型</th><th class="col-accept">验收标准</th><th class="col-evidence">制度依据</th><th class="col-evidtype">证据类型</th><th class="col-system">应用系统（S1）</th><th class="col-alert">请部门确认</th><th class="col-feedback">部门确认意见</th><th class="col-adjust">是否调整</th><th class="col-suggestion">调整建议</th></tr>';
          body.innerHTML = filteredA1().map(function(a1, i) {
            var fill = processFill(a1[11]);
            var roleCell = esc(a1[2]) + (roleWarning(a1) ? '<br><span class="warn-tag">请确认岗位</span>' : '');
            var acceptanceCell = requiresAcceptance(a1)
              ? '<span class="warn-tag">请确认关口标准</span><br>是否需要验收/完成标准'
              : '<span class="soft-warn-tag">' + esc(acceptanceText(a1)) + '</span>';
            return '<tr style="background:' + fill + '">' +
              '<td class="col-seq">' + (i+1) + '</td>' +
              '<td class="col-a1id">' + esc(a1[0]) + '</td>' +
              '<td class="col-cap">' + esc(a1[10]) + '</td>' +
              '<td class="col-proc">' + esc(a1[11]) + '</td>' +
              '<td class="col-a1name">' + esc(a1[1]) + '</td>' +
              '<td class="col-role">' + roleCell + '</td>' +
              '<td class="col-trigger">' + esc(a1[3]) + '</td>' +
              '<td class="col-precond">' + esc(a1[4]) + '</td>' +
              '<td class="col-appr"><span class="appr-tag ' + apprClass(a1[5]) + '">' + esc(a1[5]) + '</span></td>' +
              '<td class="col-accept">' + acceptanceCell + '</td>' +
              '<td class="col-evidence">' + esc(a1[7]) + '</td>' +
              '<td class="col-evidtype"><span class="evidence-tag ' + evidenceClass(a1[8]) + '">' + esc(a1[8]) + '</span></td>' +
              '<td class="col-system">' + esc(a1[6]) + '</td>' +
              '<td class="col-alert">' + (warningHtml(a1) || '<span class="soft-warn-tag">请部门确认无调整</span>') + '</td>' +
              '<td class="col-feedback feedback-cell">待部门填写</td>' +
              '<td class="col-adjust feedback-cell">待确认</td>' +
              '<td class="col-suggestion feedback-cell"></td>' +
              '</tr>';
          }).join("");
        }
      }

      function renderAll() {
        renderChart();
        renderBars();
        renderLegend();
        renderTable();
      }

      window.addEventListener("resize", function() { if (chart) chart.resize(); });
      window.addEventListener("load", function() {
        renderControls();
        renderLayoutControls();
        renderAll();
      });
    </script>
  </body>
</html>


