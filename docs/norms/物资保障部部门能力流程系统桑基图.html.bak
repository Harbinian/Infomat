<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script defer src="echarts.min.js"></script>
    <title>物资保障部 · 部门能力流程系统桑基图</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      :root {
        --blue: #1a56db;
        --teal: #0891b2;
        --bg: #f5f7fb;
        --ink: #10233f;
        --muted: #64748b;
        --border: #d9e2ef;
      }

      body {
        font-family: "Microsoft YaHei", "PingFang SC", Arial, sans-serif;
        background: var(--bg);
        color: var(--ink);
        line-height: 1.55;
      }

      .page {
        max-width: 1600px;
        margin: 0 auto;
        padding: 30px 38px 46px;
      }

      .hero {
        position: relative;
        margin-bottom: 18px;
      }

      .hero h1 {
        font-size: 30px;
        font-weight: 800;
        letter-spacing: 0;
        color: #0b2755;
      }

      .hero p {
        font-size: 14px;
        color: #475569;
        margin-top: 6px;
        max-width: 920px;
      }

      .badge {
        position: absolute;
        right: 0;
        top: 6px;
        border: 1px solid #cbd5e1;
        background: #fff;
        color: #334155;
        border-radius: 8px;
        padding: 6px 12px;
        font-size: 12px;
      }

      .read-guide {
        background: #eef6ff;
        border-left: 4px solid var(--blue);
        border-radius: 8px;
        padding: 12px 14px;
        margin: 14px 0 18px;
        color: #29415f;
        font-size: 14px;
      }

      .stat-row {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 10px;
        margin-bottom: 18px;
      }

      .stat-box {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 14px 16px;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
      }

      .stat-box .num {
        font-size: 28px;
        font-weight: 800;
        color: #0f766e;
        line-height: 1;
      }

      .stat-box .lbl {
        font-size: 13px;
        color: var(--muted);
        margin-top: 8px;
      }

      .modebar {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 12px;
        margin-bottom: 16px;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
      }

      .mode-label {
        font-size: 13px;
        color: #475569;
        margin-right: 4px;
      }

      .mode-btn {
        height: 34px;
        border: 1px solid #cbd5e1;
        background: #fff;
        color: #29415f;
        border-radius: 7px;
        padding: 0 12px;
        font-size: 13px;
        cursor: pointer;
        transition: 0.16s;
        white-space: nowrap;
      }

      .mode-btn:hover {
        border-color: var(--blue);
        color: var(--blue);
      }

      .mode-btn.active {
        background: var(--blue);
        border-color: var(--blue);
        color: #fff;
        font-weight: 700;
      }

      .layoutbar {
        margin-top: -8px;
      }

      .sankey-wrap {
        width: 100%;
        background: #0f172a;
        border-radius: 12px;
        padding: 24px 20px;
        margin-bottom: 18px;
        overflow: hidden;
      }

      .sankey-title {
        text-align: center;
        font-size: 20px;
        font-weight: 800;
        color: #f8fafc;
        margin-bottom: 4px;
        letter-spacing: 0;
      }

      .sankey-sub {
        text-align: center;
        font-size: 12px;
        color: #94a3b8;
        margin-bottom: 14px;
      }

      .sankey-chart {
        width: 100%;
        max-width: 100%;
        min-width: 0;
        height: 1120px;
      }

      .legend-row {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        justify-content: center;
        margin-top: 12px;
      }

      .legend {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #cbd5e1;
        font-size: 12px;
      }

      .legend i {
        display: inline-block;
        width: 10px;
        height: 10px;
        border-radius: 2px;
      }

      .g2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
        margin-bottom: 18px;
      }

      .note {
        background: #fff;
        border: 1px solid var(--border);
        border-left: 4px solid var(--teal);
        border-radius: 8px;
        padding: 14px 16px;
        color: #334155;
        font-size: 14px;
      }

      .note strong {
        color: #0b2755;
      }

      .summary-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
        margin-bottom: 18px;
      }

      .panel {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 16px;
      }

      .panel h3 {
        font-size: 16px;
        margin-bottom: 10px;
        color: #0b2755;
      }

      .bar-list {
        display: grid;
        gap: 8px;
      }

      .bar-line {
        display: grid;
        grid-template-columns: 190px 1fr 36px;
        gap: 10px;
        align-items: center;
        font-size: 13px;
        color: #334155;
      }

      .bar-track {
        height: 10px;
        border-radius: 999px;
        background: #e2e8f0;
        overflow: hidden;
      }

      .bar-fill {
        height: 100%;
        border-radius: 999px;
        background: var(--blue);
      }

      .table-wrap {
        overflow-x: hidden;
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 8px;
        margin-bottom: 18px;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        font-size: 12px;
      }

      .table-l3 {
        table-layout: fixed;
      }

      .table-a1 {
        table-layout: fixed;
        min-width: 0;
      }

      th, td {
        padding: 7px 6px;
        border-bottom: 1px solid #e5ebf3;
        text-align: left;
        vertical-align: top;
        word-break: break-word;
        overflow-wrap: anywhere;
      }

      th {
        background: #f1f5f9;
        color: #334155;
        font-weight: 700;
        position: sticky;
        top: 0;
        z-index: 1;
      }

      th.col-seq, td.col-seq {
        width: 32px;
        text-align: center;
      }

      th.col-a1id, td.col-a1id {
        width: 60px;
        white-space: normal;
      }

      th.col-dept, td.col-dept {
        width: 58px;
        white-space: nowrap;
      }

      th.col-domain, td.col-domain {
        width: 90px;
      }

      th.col-cap, td.col-cap {
        width: 82px;
      }

      th.col-proc, td.col-proc {
        width: 96px;
      }

      th.col-a1name, td.col-a1name {
        width: 128px;
      }

      th.col-role, td.col-role {
        width: 78px;
      }

      th.col-trigger, td.col-trigger {
        width: 102px;
      }

      th.col-precond, td.col-precond {
        width: 90px;
      }

      th.col-appr, td.col-appr {
        width: 58px;
        white-space: nowrap;
      }

      th.col-accept, td.col-accept {
        width: 92px;
      }

      th.col-evidence, td.col-evidence {
        width: 106px;
      }

      th.col-evidtype, td.col-evidtype {
        width: 58px;
        white-space: nowrap;
      }

      th.col-system, td.col-system {
        width: 58px;
      }

      th.col-alert, td.col-alert {
        width: 94px;
      }

      th.col-feedback, td.col-feedback {
        width: 78px;
      }

      th.col-adjust, td.col-adjust {
        width: 54px;
      }

      th.col-suggestion, td.col-suggestion {
        width: 78px;
      }

      tr:last-child td {
        border-bottom: none;
      }

      .domain-pill {
        display: inline-flex;
        align-items: center;
        min-height: 24px;
        padding: 2px 8px;
        border-radius: 7px;
        color: #fff;
        font-size: 12px;
        white-space: normal;
      }

      .evidence-tag {
        display: inline-block;
        padding: 1px 6px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
      }

      .evidence-tag.explicit {
        background: #dcfce7;
        color: #166534;
      }

      .evidence-tag.inferred {
        background: #fef3c7;
        color: #92400e;
      }

      .appr-tag {
        display: inline-block;
        padding: 1px 6px;
        border-radius: 4px;
        font-size: 11px;
      }

      .appr-tag.none { background: #e2e8f0; color: #475569; }
      .appr-tag.single { background: #dbeafe; color: #1e40af; }
      .appr-tag.multi { background: #fce7f3; color: #9d174d; }
      .appr-tag.cosign { background: #e0e7ff; color: #3730a3; }

      .warn-tag {
        display: inline-block;
        margin: 0 4px 4px 0;
        padding: 2px 6px;
        border-radius: 4px;
        background: #fef3c7;
        color: #92400e;
        font-size: 11px;
        font-weight: 700;
        line-height: 1.35;
      }

      .soft-warn-tag {
        display: inline-block;
        margin: 0 4px 4px 0;
        padding: 2px 6px;
        border-radius: 4px;
        background: #e0f2fe;
        color: #075985;
        font-size: 11px;
        font-weight: 700;
        line-height: 1.35;
      }

      .feedback-cell {
        color: #64748b;
        font-size: 11px;
      }

      .foot {
        margin-top: 14px;
        font-size: 12px;
        color: #64748b;
      }

      @media (max-width: 900px) {
        .page {
          padding: 20px 14px 34px;
        }
        .badge {
          position: static;
          display: inline-block;
          margin-top: 10px;
        }
        .stat-row {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
        .g2, .summary-grid {
          grid-template-columns: 1fr;
        }
        .sankey-chart {
          height: 1120px;
        }
        .bar-line {
          grid-template-columns: 160px 1fr 34px;
        }
        .table-a1 {
          min-width: 0;
        }
      }
    </style>
  </head>
  <body>
    <main class="page">
      <section class="hero">
        <h1>物资保障部 · 部门能力流程系统桑基图</h1>
        <p>部门（D1）→ 能力域（L1）→ 业务能力（L2）→ 业务流程（L3）→ 业务行为（A1）→ 应用系统（S1）。含139条业务行为（A1），覆盖6大能力域44条业务流程（L3）。</p>
        <div class="badge">部门审核稿 · 待反馈</div>
      </section>

      <div class="read-guide">
        <strong>读图方法：</strong>"全域总览"看物资保障部覆盖哪些领域和系统；切换到具体能力域（L1），看 业务能力（L2）→ 业务流程（L3）→ 业务行为（A1）→ 应用系统（S1） 的四层细节。悬停连线可见制度依据和系统设计依据。业务行为（A1）节点显示行为名称和执行角色，业务行为（A1）编号保留在悬停提示和明细表中用于追溯。下方明细表在"全域总览"显示业务流程（L3）行，在能力域视图显示业务行为（A1）行。
      </div>

            <section class="stat-row">
        <div class="stat-box"><div class="num">1</div><div class="lbl">部门（D1）</div></div>
        <div class="stat-box"><div class="num">6</div><div class="lbl">能力域（L1）</div></div>
        <div class="stat-box"><div class="num">19</div><div class="lbl">业务能力（L2）</div></div>
        <div class="stat-box"><div class="num">44</div><div class="lbl">业务流程（L3）</div></div>
        <div class="stat-box"><div class="num">139</div><div class="lbl">业务行为（A1）</div></div>
        <div class="stat-box"><div class="num">4</div><div class="lbl">应用系统（S1）</div></div>
      </section>

      <section class="modebar" id="modebar">
        <span class="mode-label">视图</span>
      </section>

      <section class="modebar layoutbar" id="layoutbar">
        <span class="mode-label">布局</span>
      </section>

      <section class="sankey-wrap">
        <div class="sankey-title" id="chartTitle">物资保障部全域总览</div>
        <div class="sankey-sub" id="chartSub">部门（D1）→ 能力域（L1）→ 业务能力（L2）→ 应用系统（S1）</div>
        <div id="chart" class="sankey-chart"></div>
        <div class="legend-row" id="legendRow"></div>
      </section>

      <section class="g2">
        <div class="note">
          <strong>应用系统（S1）口径：</strong>只展示OA、MES、PLM、ERP四类面向员工使用的信息化系统；MDM和外部海关平台不作为应用系统（S1）节点。
        </div>
        <div class="note">
          <strong>部门审核口径：</strong>本页用于部门逐条确认业务行为（A1）。证据类型需区分"原文明确-正文"、"原文明确-流程图"、"原文明确-表单"、"上下文推断"或"分析拆分"；执行角色、触发情景、前置条件可由部门补充或修正。验收标准只检查业务流程（L3）最终环节或跨部门交接前的最后环节；跟踪类任务优先由系统待办提醒、到期预警和进度展示承载。
        </div>
      </section>

      <section class="summary-grid">
        <div class="panel">
          <h3>能力域（L1）规模（业务行为（A1）数）</h3>
          <div class="bar-list" id="domainBars"></div>
        </div>
        <div class="panel">
          <h3>系统承载分布（A1参与次数）</h3>
          <div class="bar-list" id="systemBars"></div>
        </div>
      </section>

      <section class="table-wrap">
        <table id="mappingTable">
          <thead id="tableHead"></thead>
          <tbody id="mappingBody"></tbody>
        </table>
      </section>

      <div class="foot">
        数据来源：物资保障部业务资料、部门-能力-流程-系统映射关系与业务行为（A1）明细；应用系统（S1）口径限定为OA、MES、PLM、ERP。
      </div>
    </main>

    <script>
      // ===== L3 层数据（全域总览）=====
      var l3Rows = [
        {
                "domain": "工装需求与设计管理",
                "capability": "工装工具策划管理",
                "process": "工装工具品种表编制、评审、审批与发布",
                "evidence": "GLG1407-A《工装工具管理规则》§5.1；GLC140701-A《工装工具策划》§6.3.1-§6.3.7、§7.1.2",
                "system": "PLM、ERP",
                "basis": "PLM承接制造总方案、工装测算表、装配协调方案等技术依据；ERP承接工装预算、采买计划和品种表费用关联"
        },
        {
                "domain": "工装需求与设计管理",
                "capability": "工装工具策划管理",
                "process": "工装定检目录编制、定检计划编制与发布",
                "evidence": "GLG1407-A《工装工具管理规则》§5.1.c；GLC140701-A《工装工具策划》§6.3.9、§7.1.2(5)-(7)",
                "system": "MES、OA",
                "basis": "MES承接生产计划安排和定检执行触发；OA承载定检目录和计划的审批发布"
        },
        {
                "domain": "工装需求与设计管理",
                "capability": "工艺装备申请管理",
                "process": "工艺装备申请单编制、技术方案审核、设计审核、管理审核与批准",
                "evidence": "GLG1407-A《工装工具管理规则》§5.2.a；GLC14070201-A《工艺装备申请》§6.3.1-§6.3.12、§7.1.2(1)-(5)；GLB14070201-01-A《工装技术方案评审标准》全文",
                "system": "OA、PLM",
                "basis": "OA承载申请单多级审批流转和派工号自动生成；PLM承载工艺网络图、工程数据集、三维模型等设计依据"
        },
        {
                "domain": "工装需求与设计管理",
                "capability": "工艺装备申请管理",
                "process": "样板/数据集申请单编制与审批",
                "evidence": "GLC14070201-A《工艺装备申请》§6.3.1、§7.1；FM1407-46",
                "system": "OA、PLM",
                "basis": "OA承载申请单审批流转；PLM承载样板和制造数据集的技术依据"
        },
        {
                "domain": "工装需求与设计管理",
                "capability": "工装设计与更改管理",
                "process": "工装设计（含产品包装设计、专用工具设计、样板数据集设计）、工装数据校对、审核、标审、审查与批准",
                "evidence": "GLG1407-A《工装工具管理规则》§5.2.b-c；GLC14070202-A《工装设计与更改》§6.3.1-§6.3.2、§7.1.2(1)-(7)；GLB14070202-05-A《工装数据集管理标准》全文",
                "system": "PLM",
                "basis": "工装三维建模（CATIA V5）、二维图纸、数据集管理均在PLM域完成；工装设计依据（工程数据集、制造数据集、模线样板）由PLM提供"
        },
        {
                "domain": "工装需求与设计管理",
                "capability": "工装设计与更改管理",
                "process": "工装数据更改（先行更改G/J类处理、换版更改、版次升级）与工装数据发放",
                "evidence": "GLG1407-A《工装工具管理规则》§5.2.c；GLC14070202-A《工装设计与更改》§6.3.3、§6.5、§7.1.2(8)",
                "system": "PLM、OA",
                "basis": "PLM承接工装数据版次管理、电子数据发放和存档；OA承载分发路线通知和纸介质图样按需发放的流转"
        },
        {
                "domain": "工装需求与设计管理",
                "capability": "工装设计与更改管理",
                "process": "工装设计评审（PDR/CDR/FDR三个阶段或五阶段评审）",
                "evidence": "GLG1407-A《工装工具管理规则》§5.2.b；GLC14070202-A《工装设计与更改》§6.4、§7.1.2(2)；GLB14070202-02-A《商飞项目工装的评审与设计管理标准》全文",
                "system": "PLM、OA",
                "basis": "PLM承载评审所需的工装数据、设计资料和三维模型；OA承载评审会议组织、评审纪要签审和行动项跟踪闭环"
        },
        {
                "domain": "工装需求与设计管理",
                "capability": "工装设计与更改管理",
