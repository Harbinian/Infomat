        ["CW-L3-16-A02","每日盘点现金，做到日清月结","出纳","每日终了","当日现金收付已完成","无审批","ERP","GLTX-CW-03-A §5.2.4","原文明确-正文","资金管理","现金与票据管理","现金收付与库存管理",""],
        ["CW-L3-16-A03","每月抽查盘点现金并编制现金盘点表","财务部","每月","出纳已完成日盘点","单人审批","ERP","GLTX-CW-03-A §5.2.4","原文明确-正文","资金管理","现金与票据管理","现金收付与库存管理","财务部为部门级角色，请确认具体抽查岗位"],
        // CW-L3-17 票据收取、开具与背书管理
        ["CW-L3-17-A01","审核收取票据的真实性与要素完整性","出纳或会计","收到商业汇票时","对应交易业务已确认","无审批","ERP","GLTX-CW-03-A §5.5.1","原文明确-正文","资金管理","现金与票据管理","票据收取、开具与背书管理","请部门确认票据审核岗位（出纳/会计）"],
        ["CW-L3-17-A02","经审批后开具票据并登记应付票据备查簿","会计","采购付款需开具票据时","付款申请已审批","单人审批","ERP、OA","GLTX-CW-03-A §5.5.3","原文明确-正文","资金管理","现金与票据管理","票据收取、开具与背书管理",""],
        ["CW-L3-17-A03","办理票据贴现与到期托收","出纳","票据到期前10日或需提前贴现时","票据台账已记录","单人审批","ERP、OA","GLTX-CW-03-A §5.5.4","原文明确-正文","资金管理","现金与票据管理","票据收取、开具与背书管理",""],
        // CW-L3-18 月度资金计划编制与执行管理
        ["CW-L3-18-A01","接收各部门报送的月度资金需求计划与回款计划","财务部","每月28号前","各部门已完成计划编制并经负责人签字","无审批","OA","GLTX-CW-03-A §5.6.1","原文明确-正文","资金管理","资金计划与备用金管理","月度资金计划编制与执行管理","财务部为部门级角色，请确认具体接收岗位"],
        ["CW-L3-18-A02","审核核对各部门资金计划","财务部","收到各部门计划后","各部门计划已报送","单人审批","OA、ERP","GLTX-CW-03-A §5.6.1","原文明确-正文","资金管理","资金计划与备用金管理","月度资金计划编制与执行管理",""],
        ["CW-L3-18-A03","汇总编制公司月度资金计划表并提交总部财务","财务部","各部门计划审核完成后","各部门计划已审核通过","多级审批","OA、ERP","GLTX-CW-03-A §5.6.2","原文明确-正文","资金管理","资金计划与备用金管理","月度资金计划编制与执行管理",""],
        ["CW-L3-18-A04","执行月度资金收支计划并监控执行偏差","财务部","计划审批后每月执行","月度资金计划已审批确认","无审批","ERP","GLTX-CW-03-A §5.6.3","原文明确-正文","资金管理","资金计划与备用金管理","月度资金计划编制与执行管理","资金计划执行监控是重点，建议通过ERP实现预警"],
        // CW-L3-19 备用金借支与核销管理
        ["CW-L3-19-A01","审核备用金借支申请（一事一议、前清后借）","财务部","业务部门提交借支申请时","借支范围符合规定","单人审批","OA","GLTX-CW-03-A §5.7.1、§5.7.2","原文明确-正文","资金管理","资金计划与备用金管理","备用金借支与核销管理",""],
        ["CW-L3-19-A02","督促借款人及时报销冲账","财务部","借支发生后","备用金已借出","无审批","OA","GLTX-CW-03-A §5.7.2","原文明确-正文","资金管理","资金计划与备用金管理","备用金借支与核销管理","建议通过OA待办提醒实现自动催报"],
        ["CW-L3-19-A03","年末全面清理备用金，逾期未归还者从工资中扣回","财务部","每年年末","备用金借支台账已建立","无审批","ERP","GLTX-CW-03-A §5.7.3","原文明确-正文","资金管理","资金计划与备用金管理","备用金借支与核销管理","输出目标为行政人事部，跨部门交接环节"],

        // === 费用报销管理 ===
        // CW-L3-20 出差申请与审批管理
        ["CW-L3-20-A01","出差人提交钉钉出差申请（注明事由、行程）","出差人","确定出差安排时","出差需求已确认","无审批","OA","GLTX-CW-04-A §5.1.1(1)","原文明确-正文","费用报销管理","差旅费管理","出差申请与审批管理",""],
        ["CW-L3-20-A02","部门负责人审批出差申请（核定出差必要性及时间）","部门负责人","出差人提交申请后","出差人已提交申请","单人审批","OA","GLTX-CW-04-A §5.1.1(2)","原文明确-正文","费用报销管理","差旅费管理","出差申请与审批管理",""],
        ["CW-L3-20-A03","抄送出差信息至行政人事部","出差人或系统自动","出差申请审批通过后","出差申请已获批准","无审批","OA","GLTX-CW-04-A 表8","原文明确-流程图","费用报销管理","差旅费管理","出差申请与审批管理","抄送为系统自动还是人工操作需确认"],
        // CW-L3-21 差旅费用报销管理
        ["CW-L3-21-A01","出差人整理报销单据并提交报销申请","出差人","出差返回后一个月内","出差已完成返回公司","无审批","OA","GLTX-CW-04-A §5.1.2(1)","原文明确-正文","费用报销管理","差旅费管理","差旅费用报销管理",""],
        ["CW-L3-21-A02","部门负责人审核差旅费真实性、合理性","部门负责人","出差人提交报销申请后","报销申请已提交","单人审批","OA","GLTX-CW-04-A §5.1.2(2)、表3","原文明确-正文","费用报销管理","差旅费管理","差旅费用报销管理",""],
        ["CW-L3-21-A03","财务部审核差旅费用单据合规性","财务部","部门负责人审核通过后","部门审核已通过","单人审批","OA","GLTX-CW-04-A §5.2、表3","原文明确-正文","费用报销管理","差旅费管理","差旅费用报销管理",""],
        ["CW-L3-21-A04","办理差旅报销款银行电汇支付","财务部出纳","审批全部完成后","报销申请已完成全部审批","无审批","ERP","GLTX-CW-04-A §5.2.5(4)","原文明确-正文","费用报销管理","差旅费管理","差旅费用报销管理",""],
        // CW-L3-22 报销与付款审批管理
        ["CW-L3-22-A01","申请人整理报销/付款单据并提交至财务部","申请人","费用发生或付款到期","费用已发生/付款条件已满足","无审批","OA","GLTX-CW-05-A §5.2.1","原文明确-正文","费用报销管理","财务报销与付款管理","报销与付款审批管理",""],
        ["CW-L3-22-A02","财务部全面审核单据并签字","财务部审核岗","收到申请人提交的完整单据后","单据已完整提交","单人审批","OA","GLTX-CW-05-A §5.2.2(1)、§6","原文明确-正文","费用报销管理","财务报销与付款管理","报销与付款审批管理",""],
        ["CW-L3-22-A03","财务部长审批","财务部长","财务审核签字后","财务审核已完成","单人审批","OA","GLTX-CW-05-A §5.2.2(2)、§6","原文明确-正文","费用报销管理","财务报销与付款管理","报销与付款审批管理",""],
        ["CW-L3-22-A04","副总审批","副总","财务部长审批后","财务部长已审批","单人审批","OA","GLTX-CW-05-A §5.2.2(2)、§6","原文明确-正文","费用报销管理","财务报销与付款管理","报销与付款审批管理",""],
        ["CW-L3-22-A05","总经理审批","总经理","副总审批后","副总已审批","单人审批","OA","GLTX-CW-05-A §5.2.2(3)、§6","原文明确-正文","费用报销管理","财务报销与付款管理","报销与付款审批管理",""],
        ["CW-L3-22-A06","董事长审批（每周统一提交，签字后补）","董事长","总经理审批后","总经理已审批","单人审批","OA","GLTX-CW-05-A §5.2.2(4)、§6","原文明确-正文","费用报销管理","财务报销与付款管理","报销与付款审批管理",""],
        ["CW-L3-22-A07","出纳办理付款（每周五固定付款日）","出纳","董事长审批通过后，每周五付款日","董事长已审批","无审批","ERP","GLTX-CW-05-A §5.2.3、§6","原文明确-正文","费用报销管理","财务报销与付款管理","报销与付款审批管理",""],
        // CW-L3-23 打车费报销专项管理
        ["CW-L3-23-A01","员工打车前通过钉钉提交公出申请","坐班车员工","确定公务出行需打车时","符合公务外出或夜班打车条件","单人审批","OA","GLTX-CW-05-A §5.3.2","原文明确-正文","费用报销管理","财务报销与付款管理","打车费报销专项管理",""],
        ["CW-L3-23-A02","员工将打车报销材料提交至班组汇总","坐班车员工","每月打车费发生后","已取得完整报销材料","无审批","OA","GLTX-CW-05-A §5.3.3","原文明确-正文","费用报销管理","财务报销与付款管理","打车费报销专项管理",""],
        ["CW-L3-23-A03","班组每月20日报送打车费材料至行政人事部复核","班组负责人","每月20日","当月打车费材料已汇总","无审批","OA","GLTX-CW-05-A §5.3.3","原文明确-正文","费用报销管理","财务报销与付款管理","打车费报销专项管理",""],
        ["CW-L3-23-A04","行政人事部复核（考勤、身份、路线、加班真实性）","行政人事部","收到班组材料后","班组已提交材料","无审批","OA","GLTX-CW-05-A §5.3.3","原文明确-正文","费用报销管理","财务报销与付款管理","打车费报销专项管理","此角色为行政人事部，非财务部"],
        ["CW-L3-23-A05","财务部按付款时间规定完成打车费付款","财务部出纳","行政人事部复核通过后","行政人事部复核已完成","无审批","ERP","GLTX-CW-05-A §5.3.3","原文明确-正文","费用报销管理","财务报销与付款管理","打车费报销专项管理","输入来源为行政人事部"]
      ];

      // ===== 颜色方案 =====
      var domainColors = { "成本管理":"#0891b2", "资产管理":"#6366f1", "资金管理":"#0d9488", "费用报销管理":"#d97706" };
      var layerColors = { "财务部":"#1a56db", "OA":"#f59e0b", "ERP":"#059669", "MES":"#7c3aed", "PLM":"#dc2626" };

      function lighten(hex, a) {
        var r=parseInt(hex.slice(1,3),16), g=parseInt(hex.slice(3,5),16), b=parseInt(hex.slice(5,7),16);
        r=Math.min(255,Math.round(r+(255-r)*a)); g=Math.min(255,Math.round(g+(255-g)*a)); b=Math.min(255,Math.round(b+(255-b)*a));
        return "rgb("+r+","+g+","+b+")";
      }

      // ===== L3 全域桑基图 =====
      function buildGlobalSankey() {
        var nodes=[], nodeIdx={}, links=[];
        function addNode(n) { if(nodeIdx[n]===undefined){ nodeIdx[n]=nodes.length; nodes.push({name:n}); } return nodeIdx[n]; }
        addNode("财务部");
        var dSet={}, cSet={}, sSet={};
        l3Rows.forEach(function(r){
          dSet[r.domain]=true; cSet[r.domain+"|||"+r.capability]=true;
          r.system.split("、").forEach(function(s){ s=s.trim(); if(s) sSet[s]=true; });
        });
        nodes=[]; nodeIdx={};
        addNode("财务部");
        Object.keys(dSet).forEach(function(d){ addNode(d); });
        Object.keys(cSet).forEach(function(c){ addNode(c); });
        Object.keys(sSet).forEach(function(s){ addNode(s); });
        Object.keys(dSet).forEach(function(d){ links.push({source:nodeIdx["财务部"],target:nodeIdx[d],value:1,lineStyle:{color:domainColors[d]}}); });
        Object.keys(cSet).forEach(function(c){
          var parts=c.split("|||"), d=parts[0];
          links.push({source:nodeIdx[d],target:nodeIdx[c],value:1,lineStyle:{color:domainColors[d]}});
        });
        var csCount={};
        l3Rows.forEach(function(r){
          var ck=r.domain+"|||"+r.capability;
          r.system.split("、").forEach(function(s){ s=s.trim(); if(!s) return; var k=ck+"→"+s; csCount[k]=(csCount[k]||0)+1; });
        });
        Object.keys(csCount).forEach(function(k){
          var parts=k.split("→"), ck=parts[0], sys=parts[1], d=ck.split("|||")[0];
          if(nodeIdx[ck]!==undefined&&nodeIdx[sys]!==undefined) links.push({source:nodeIdx[ck],target:nodeIdx[sys],value:csCount[k],lineStyle:{color:domainColors[d]}});
        });
        nodes.forEach(function(n){
          if(n.name==="财务部") n.itemStyle={color:layerColors["财务部"]};
          else if(sSet[n.name]) n.itemStyle={color:layerColors[n.name]};
          else if(dSet[n.name]) n.itemStyle={color:domainColors[n.name]};
          else if(n.name.indexOf("|||")>=0) n.itemStyle={color:lighten(domainColors[n.name.split("|||")[0]],0.3)};
        });
        return {nodes:nodes,links:links};
      }

      // ===== A1 域详情桑基图 =====
      function buildDomainSankey(domain) {
        var nodes=[], nodeIdx={}, links=[];
        function addNode(n) { if(nodeIdx[n]===undefined){ nodeIdx[n]=nodes.length; nodes.push({name:n}); } return nodeIdx[n]; }
        var caps={}, l3s={}, a1s={}, sSet={};
        var a1ByL3={};
        a1Rows.forEach(function(r){
          if(r[9]!==domain) return;
          var cap=r[10], l3=r[11], a1name=r[1]+" · "+r[2], a1id=r[0];
          caps[cap]=true;
          var l3k=l3;
          l3s[l3k]=cap;
          if(!a1ByL3[l3k]) a1ByL3[l3k]=[];
          a1ByL3[l3k].push({id:a1id,name:a1name,role:r[2],sys:r[6]});
          a1s[a1id]=a1name;
          r[6].split("、").forEach(function(s){ s=s.trim(); if(s) sSet[s]=true; });
        });
        nodes=[]; nodeIdx={};
        Object.keys(caps).forEach(function(c){ addNode("cap_"+c); });
        Object.keys(l3s).forEach(function(l){ addNode("l3_"+l); });
        Object.keys(a1ByL3).forEach(function(l){
          a1ByL3[l].forEach(function(a){ addNode("a1_"+a.id); });
        });
        Object.keys(sSet).forEach(function(s){ addNode(s); });
        Object.keys(l3s).forEach(function(l){ links.push({source:nodeIdx["cap_"+l3s[l]],target:nodeIdx["l3_"+l],value:1}); });
        Object.keys(a1ByL3).forEach(function(l){
          a1ByL3[l].forEach(function(a){
            if(nodeIdx["l3_"+l]!==undefined&&nodeIdx["a1_"+a.id]!==undefined)
              links.push({source:nodeIdx["l3_"+l],target:nodeIdx["a1_"+a.id],value:1});
            a.sys.split("、").forEach(function(s){ s=s.trim(); if(!s) return;
              if(nodeIdx["a1_"+a.id]!==undefined&&nodeIdx[s]!==undefined) links.push({source:nodeIdx["a1_"+a.id],target:nodeIdx[s],value:1,lineStyle:{color:layerColors[s]}});
            });
          });
        });
        nodes.forEach(function(n){
          if(n.name.startsWith("cap_")) n.itemStyle={color:domainColors[domain]};
          else if(n.name.startsWith("l3_")) n.itemStyle={color:lighten(domainColors[domain],0.25)};
          else if(n.name.startsWith("a1_")) n.itemStyle={color:lighten(domainColors[domain],0.5)};
          else if(sSet[n.name]) n.itemStyle={color:layerColors[n.name]};
        });
        return {nodes:nodes,links:links};
      }

      // ===== 渲染 =====
      var chartDom=document.getElementById("chart");
      var myChart=echarts.init(chartDom);
      var currentDomain=null;

      function render(currentDomain) {
        var isGlobal=!currentDomain;
        var data=isGlobal?buildGlobalSankey():buildDomainSankey(currentDomain);
        var title=isGlobal?"财务部全域总览":("财务部 · "+currentDomain);
        var sub=isGlobal?"部门（D1）→ 能力域（L1）→ 业务能力（L2）→ 应用系统（S1）":"业务能力（L2）→ 业务流程（L3）→ 业务行为（A1）→ 应用系统（S1）";

        document.getElementById("chartTitle").innerText=title;
        document.getElementById("chartSub").innerText=sub;

        var option={
          tooltip:{trigger:"item",formatter:function(p){
            if(p.dataType==="edge"||(p.data&&p.data.source&&p.data.target)){
              var src=p.data.source, tgt=p.data.target;
              if(src.startsWith("a1_")) src=src.substring(3);
              if(tgt.startsWith("a1_")) tgt=tgt.substring(3);
              return src+" → "+tgt;
            }
            var name=p.name;
            if(name.startsWith("cap_")) name=name.substring(4);
            else if(name.startsWith("l3_")) name=name.substring(3);
            else if(name.startsWith("a1_")){
              var id=name.substring(3);
              var found=null;
              a1Rows.forEach(function(r){ if(r[0]===id) found=r; });
              if(found) return "<b>"+found[1]+"</b><br/>执行角色: "+found[2]+"<br/>触发: "+found[3]+"<br/>前置: "+found[4]+"<br/>审批: "+found[5]+"<br/>系统: "+found[6]+"<br/>证据: "+found[7]+"<br/>类型: "+found[8]+(found[12]?"<br/><span style='color:#92400e'>核验: "+found[12]+"</span>":"");
            }
            return name;
          }},
          series:[{type:"sankey",layout:"none",emphasis:{focus:"adjacency"},nodeAlign:"left",layoutIterations:32,
            data:data.nodes,links:data.links,
            label:{show:true,fontSize:11,color:"#e2e8f0",formatter:function(p){
              var n=p.name;
              if(n.startsWith("cap_")) n=n.substring(4);
              else if(n.startsWith("l3_")){ n=n.substring(3); if(n.length>14) n=n.substring(0,13)+"…"; }
              else if(n.startsWith("a1_")){ var id=n.substring(3); var f=null; a1Rows.forEach(function(r){if(r[0]===id) f=r;});
                if(f) n=f[1]; else n=id; if(n.length>18) n=n.substring(0,17)+"…"; }
              return n;
            }},
            lineStyle:{color:"gradient",curveness:0.5,opacity:0.3}
          }]
        };
        myChart.setOption(option,true);

        // Legend
        var sys={};
        data.nodes.forEach(function(n){ if(["OA","ERP","MES","PLM"].indexOf(n.name)>=0) sys[n.name]=n.itemStyle?n.itemStyle.color:layerColors[n.name]; });
        var lh="";
        Object.keys(sys).forEach(function(s){ lh+='<span class="legend"><i style="background:'+sys[s]+'"></i> '+s+'</span>'; });
        Object.keys(domainColors).forEach(function(d){ if(!currentDomain||currentDomain===d) lh+='<span class="legend"><i style="background:'+domainColors[d]+'"></i> '+d+'</span>'; });
        document.getElementById("legendRow").innerHTML=lh;

        // Table
        renderTable(currentDomain);

        // Stats
        updateStats(currentDomain);
      }

      function updateStats(domain) {
        var sr=document.getElementById("statsRow");
        if(!domain){ sr.innerHTML='<div class="stat-box"><div class="num">1</div><div class="lbl">部门（D1）</div></div><div class="stat-box"><div class="num">4</div><div class="lbl">能力域（L1）</div></div><div class="stat-box"><div class="num">9</div><div class="lbl">业务能力（L2）</div></div><div class="stat-box"><div class="num">23</div><div class="lbl">业务流程（L3）</div></div><div class="stat-box"><div class="num">83</div><div class="lbl">业务行为（A1）</div></div><div class="stat-box"><div class="num">3</div><div class="lbl">应用系统（S1）</div></div>'; return; }
        var ac=0, cc=0, lc=0;
        var caps={}, l3s={};
        a1Rows.forEach(function(r){ if(r[9]===domain){ ac++; caps[r[10]]=true; l3s[r[11]]=true; } });
        cc=Object.keys(caps).length; lc=Object.keys(l3s).length;
        sr.innerHTML='<div class="stat-box"><div class="num">1</div><div class="lbl">部门（D1）</div></div><div class="stat-box"><div class="num">1</div><div class="lbl">能力域（L1）</div></div><div class="stat-box"><div class="num">'+cc+'</div><div class="lbl">业务能力（L2）</div></div><div class="stat-box"><div class="num">'+lc+'</div><div class="lbl">业务流程（L3）</div></div><div class="stat-box"><div class="num">'+ac+'</div><div class="lbl">业务行为（A1）</div></div><div class="stat-box"><div class="num">3</div><div class="lbl">应用系统（S1）</div></div>';
      }

      function renderTable(filterDomain) {
        var thead=document.getElementById("tableHead");
        var body=document.getElementById("mappingBody");
        if(!filterDomain){
          // L3 global table
          thead.innerHTML='<tr><th class="col-seq">序号</th><th class="col-dept">部门（D1）</th><th class="col-domain">能力域（L1）</th><th class="col-cap">业务能力（L2）</th><th class="col-proc">业务流程（L3）</th><th class="col-evidence">制度依据（文件号/条款）</th><th class="col-system">应用系统（S1）</th><th style="width:160px">系统设计依据</th></tr>';
          var h="";
          l3Rows.forEach(function(r,i){ h+='<tr><td class="col-seq">'+(i+1)+'</td><td class="col-dept">财务部</td><td class="col-domain">'+r.domain+'</td><td class="col-cap">'+r.capability+'</td><td class="col-proc">'+r.process+'</td><td class="col-evidence">'+r.evidence+'</td><td class="col-system">'+r.system+'</td><td style="width:160px">'+r.basis+'</td></tr>'; });
          body.innerHTML=h;
        } else {
          // A1 detail table
          thead.innerHTML='<tr><th class="col-seq">序号</th><th class="col-a1id">业务行为（A1）编号</th><th class="col-a1name">业务行为（A1）</th><th class="col-role">执行角色</th><th class="col-trigger">触发情景</th><th class="col-precond">前置条件</th><th class="col-appr">审批类型</th><th class="col-system">应用系统（S1）</th><th class="col-evidence">制度依据</th><th class="col-evidtype">证据类型</th><th class="col-alert">核验提醒</th><th class="col-feedback">部门确认意见</th><th class="col-adjust">是否调整</th><th class="col-suggestion">调整建议</th></tr>';
          var h="", seq=0, prevL3="";
          a1Rows.forEach(function(r,i){
            if(r[9]!==filterDomain) return;
            seq++;
            var l3Cls=(r[11]!==prevL3)?" l3-group-start":"";
            prevL3=r[11];
            var apprCls="";
            switch(r[5]){ case "无审批":apprCls="none";break; case "单人审批":apprCls="single";break; case "多级审批":apprCls="multi";break; case "会签":apprCls="cosign";break; }
            var alertHtml=r[12]?'<span class="warn-tag">'+r[12]+'</span>':"";
            h+='<tr class="'+l3Cls+'"><td class="col-seq">'+seq+'</td><td class="col-a1id">'+r[0]+'</td><td class="col-a1name">'+r[1]+'</td><td class="col-role">'+r[2]+'</td><td class="col-trigger">'+r[3]+'</td><td class="col-precond">'+r[4]+'</td><td class="col-appr"><span class="appr-tag '+apprCls+'">'+r[5]+'</span></td><td class="col-system">'+r[6]+'</td><td class="col-evidence">'+r[7]+'</td><td class="col-evidtype">'+r[8]+'</td><td class="col-alert">'+alertHtml+'</td><td class="col-feedback feedback-cell"></td><td class="col-adjust feedback-cell">待确认</td><td class="col-suggestion feedback-cell"></td></tr>';
          });
          body.innerHTML=h;
        }
      }

      function buildSummaryBars() {
        var dc={};
        a1Rows.forEach(function(r){ dc[r[9]]=(dc[r[9]]||0)+1; });
        var maxD=Math.max.apply(null,Object.values(dc));
        var dhtml="";
        Object.keys(dc).forEach(function(d){ var pct=Math.round(dc[d]/maxD*100); dhtml+='<div class="bar-line"><span>'+d+'</span><div class="bar-track"><div class="bar-fill" style="width:'+pct+'%;background:'+(domainColors[d]||"#64748b")+'"></div></div><span>'+dc[d]+'</span></div>'; });
        document.getElementById("domainBars").innerHTML=dhtml;
        var sc={};
        a1Rows.forEach(function(r){ r[6].split("、").forEach(function(s){ s=s.trim(); if(s) sc[s]=(sc[s]||0)+1; }); });
        var maxS=Math.max.apply(null,Object.values(sc));
        var shtml="";
        ["ERP","OA","MES","PLM"].forEach(function(s){ if(sc[s]){ var pct=Math.round(sc[s]/maxS*100); shtml+='<div class="bar-line"><span>'+s+'</span><div class="bar-track"><div class="bar-fill" style="width:'+pct+'%;background:'+(layerColors[s]||"#64748b")+'"></div></div><span>'+sc[s]+'</span></div>'; } });
        document.getElementById("systemBars").innerHTML=shtml;
      }

      function buildModeButtons() {
        var bar=document.getElementById("modebar");
        var domains=["全域总览"];
        var seen={};
        l3Rows.forEach(function(r){ if(!seen[r.domain]){ seen[r.domain]=true; domains.push(r.domain); } });
        var html='<span class="mode-label">能力域（L1）视图</span>';
        domains.forEach(function(d,i){ html+='<button class="mode-btn'+(i===0?" active":"")+'" data-domain="'+(d==="全域总览"?"":d)+'">'+d+'</button>'; });
        bar.innerHTML=html;
        bar.addEventListener("click",function(e){
          if(e.target.tagName==="BUTTON"){
            var btns=bar.querySelectorAll("button"); btns.forEach(function(b){ b.classList.remove("active"); });
            e.target.classList.add("active");
            var d=e.target.getAttribute("data-domain");
            render(d||null);
          }
        });
      }

      buildModeButtons();
      buildSummaryBars();
      render(null);
      window.addEventListener("resize",function(){ myChart.resize(); });
    </script>
  </body>
</html>
