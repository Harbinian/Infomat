<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>财务部 · 部门能力流程系统桑基图</title>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      :root {
        --blue: #1a56db; --teal: #0891b2; --bg: #f5f7fb; --ink: #10233f;
        --muted: #64748b; --border: #d9e2ef;
      }
      body { font-family: "Microsoft YaHei", "PingFang SC", Arial, sans-serif; background: var(--bg); color: var(--ink); line-height: 1.55; }
      .page { max-width: 1600px; margin: 0 auto; padding: 30px 38px 46px; }
      .hero { position: relative; margin-bottom: 18px; }
      .hero h1 { font-size: 30px; font-weight: 800; color: #0b2755; }
      .hero p { font-size: 14px; color: #475569; margin-top: 6px; max-width: 920px; }
      .badge { position: absolute; right: 0; top: 6px; border: 1px solid #cbd5e1; background: #fff; color: #334155; border-radius: 8px; padding: 6px 12px; font-size: 12px; }
      .read-guide { background: #eef6ff; border-left: 4px solid var(--blue); border-radius: 8px; padding: 12px 14px; margin: 14px 0 18px; color: #29415f; font-size: 14px; }
      .stat-row { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 10px; margin-bottom: 18px; }
      .stat-box { background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 14px 16px; box-shadow: 0 1px 2px rgba(15,23,42,0.04); }
      .stat-box .num { font-size: 28px; font-weight: 800; color: #0f766e; line-height: 1; }
      .stat-box .lbl { font-size: 13px; color: var(--muted); margin-top: 8px; }
      .modebar { background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 12px; margin-bottom: 16px; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
      .mode-label { font-size: 13px; color: #475569; margin-right: 4px; }
      .mode-btn { height: 34px; border: 1px solid #cbd5e1; background: #fff; color: #29415f; border-radius: 7px; padding: 0 12px; font-size: 13px; cursor: pointer; transition: 0.16s; white-space: nowrap; }
      .mode-btn:hover { border-color: var(--blue); color: var(--blue); }
      .mode-btn.active { background: var(--blue); border-color: var(--blue); color: #fff; font-weight: 700; }
      .sankey-wrap { width: 100%; background: #0f172a; border-radius: 12px; padding: 24px 20px; margin-bottom: 18px; overflow: hidden; }
      .sankey-title { text-align: center; font-size: 20px; font-weight: 800; color: #f8fafc; margin-bottom: 4px; }
      .sankey-sub { text-align: center; font-size: 12px; color: #94a3b8; margin-bottom: 14px; }
      .sankey-chart { width: 100%; max-width: 100%; min-width: 0; height: 700px; }
      .legend-row { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin-top: 12px; }
      .legend { display: inline-flex; align-items: center; gap: 6px; color: #cbd5e1; font-size: 12px; }
      .legend i { display: inline-block; width: 10px; height: 10px; border-radius: 2px; }
      .g2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 18px; }
      .note { background: #fff; border: 1px solid var(--border); border-left: 4px solid var(--teal); border-radius: 8px; padding: 14px 16px; color: #334155; font-size: 14px; }
      .note strong { color: #0b2755; }
      .summary-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 18px; }
      .panel { background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 16px; }
      .panel h3 { font-size: 16px; margin-bottom: 10px; color: #0b2755; }
      .bar-list { display: grid; gap: 8px; }
      .bar-line { display: grid; grid-template-columns: 120px 1fr 40px; gap: 10px; align-items: center; font-size: 13px; color: #334155; }
      .bar-track { height: 10px; border-radius: 999px; background: #e2e8f0; overflow: hidden; }
      .bar-fill { height: 100%; border-radius: 999px; }
      .table-wrap { overflow-x: hidden; background: #fff; border: 1px solid var(--border); border-radius: 8px; margin-bottom: 18px; }
      table { width: 100%; border-collapse: collapse; font-size: 12px; }
      th, td { padding: 6px 5px; border-bottom: 1px solid #e5ebf3; text-align: left; vertical-align: top; word-break: break-word; overflow-wrap: anywhere; }
      th { background: #f1f5f9; color: #334155; font-weight: 700; position: sticky; top: 0; z-index: 1; }
      .col-seq { width: 28px; text-align: center; }
      .col-a1id { width: 72px; white-space: normal; }
      .col-dept { width: 50px; white-space: nowrap; }
      .col-domain { width: 72px; }
      .col-cap { width: 70px; }
      .col-proc { width: 100px; }
      .col-a1name { width: 110px; }
      .col-role { width: 80px; }
      .col-trigger { width: 80px; }
      .col-precond { width: 70px; }
      .col-appr { width: 52px; white-space: nowrap; }
      .col-accept { width: 70px; }
      .col-evidence { width: 110px; }
      .col-evidtype { width: 56px; white-space: nowrap; }
      .col-system { width: 52px; }
      .col-alert { width: 80px; }
      .col-feedback { width: 70px; }
      .col-adjust { width: 52px; }
      .col-suggestion { width: 70px; }
      tr:last-child td { border-bottom: none; }
      .l3-group-start td { border-top: 2px solid #94a3b8; }
      .warn-tag { display: inline-block; margin: 0 4px 4px 0; padding: 2px 6px; border-radius: 4px; background: #fef3c7; color: #92400e; font-size: 11px; font-weight: 700; }
      .appr-tag { display: inline-block; padding: 1px 6px; border-radius: 4px; font-size: 11px; }
      .appr-tag.none { background: #e2e8f0; color: #475569; }
      .appr-tag.single { background: #dbeafe; color: #1e40af; }
      .appr-tag.multi { background: #fce7f3; color: #9d174d; }
      .appr-tag.cosign { background: #e0e7ff; color: #3730a3; }
      .feedback-cell { color: #64748b; font-size: 11px; }
      .foot { margin-top: 14px; font-size: 12px; color: #64748b; }
      @media (max-width: 900px) {
        .page { padding: 20px 14px 34px; }
        .badge { position: static; display: inline-block; margin-top: 10px; }
        .stat-row { grid-template-columns: repeat(3, minmax(0, 1fr)); }
        .g2, .summary-grid { grid-template-columns: 1fr; }
        .sankey-chart { height: 500px; }
      }
    </style>
  </head>
  <body>
    <main class="page">
      <section class="hero">
        <h1>财务部 · 部门能力流程系统桑基图</h1>
        <p>部门（D1）→ 能力域（L1）→ 业务能力（L2）→ 应用系统（S1）[全域]；业务能力（L2）→ 业务流程（L3）→ 业务行为（A1）→ 应用系统（S1）[域详情]。含83条业务行为（A1），覆盖4大能力域23条业务流程（L3）。</p>
        <div class="badge">部门审核稿 · 待反馈</div>
      </section>

      <div class="read-guide">
        <strong>读图方法：</strong>"全域总览"看财务部覆盖哪些领域和系统；切换到具体能力域（L1），看 业务能力（L2）→ 业务流程（L3）→ 业务行为（A1）→ 应用系统（S1） 的四层细节。悬停连线可见制度依据。业务行为（A1）节点显示行为名称和执行角色。明细表含部门确认意见、是否调整、调整建议字段，供部门逐条核验反馈。
      </div>

      <section class="stat-row" id="statsRow">
        <div class="stat-box"><div class="num">1</div><div class="lbl">部门（D1）</div></div>
        <div class="stat-box"><div class="num">4</div><div class="lbl">能力域（L1）</div></div>
        <div class="stat-box"><div class="num">9</div><div class="lbl">业务能力（L2）</div></div>
        <div class="stat-box"><div class="num">23</div><div class="lbl">业务流程（L3）</div></div>
        <div class="stat-box"><div class="num">83</div><div class="lbl">业务行为（A1）</div></div>
        <div class="stat-box"><div class="num">3</div><div class="lbl">应用系统（S1）</div></div>
      </section>

      <section class="modebar" id="modebar">
        <span class="mode-label">能力域（L1）视图</span>
      </section>

      <section class="sankey-wrap">
        <div class="sankey-title" id="chartTitle">财务部全域总览</div>
        <div class="sankey-sub" id="chartSub">部门（D1）→ 能力域（L1）→ 业务能力（L2）→ 应用系统（S1）</div>
        <div id="chart" class="sankey-chart"></div>
        <div class="legend-row" id="legendRow"></div>
      </section>

      <section class="g2">
        <div class="note"><strong>应用系统（S1）口径：</strong>只展示OA、MES、PLM、ERP四类面向员工使用的信息化系统；MDM作为后台数据治理平台不出现在系统节点中。</div>
        <div class="note"><strong>部门审核口径：</strong>本页用于财务部逐条确认业务行为（A1）。证据类型区分"原文明确-正文""原文明确-流程图""原文明确-表单""上下文推断"或"分析拆分"；执行角色、触发情景、前置条件可由部门补充或修正。</div>
      </section>

      <section class="summary-grid">
        <div class="panel"><h3>能力域（L1）规模（业务行为（A1）数）</h3><div class="bar-list" id="domainBars"></div></div>
        <div class="panel"><h3>系统承载分布（A1参与次数）</h3><div class="bar-list" id="systemBars"></div></div>
      </section>

      <section class="table-wrap">
        <table id="mappingTable"><thead id="tableHead"></thead><tbody id="mappingBody"></tbody></table>
      </section>

      <div class="foot">数据来源：财务部业务资料中的6个GLTX-CW程序文件。应用系统（S1）口径限定为OA、MES、PLM、ERP。业务行为（A1）分解基于L3映射文档和源文件全文条款。</div>
    </main>

    <script src="echarts.min.js"></script>
    <script>
      // ===== L3 数据（全域总览）=====
      var l3Rows = [
        {"domain":"成本管理","capability":"成本核算管理","process":"生产成本定额管理与指标分解","evidence":"GLTX-CW-01-A《财务成本核算管理程序》§5.1.1","system":"ERP、OA","basis":"ERP：BOM定额、成本预测数据维护；OA：定额标准审批"},
        {"domain":"成本管理","capability":"成本核算管理","process":"生产成本事中控制","evidence":"GLTX-CW-01-A《财务成本核算管理程序》§5.1.2","system":"ERP、MES","basis":"ERP：物料消耗、人工工时、折旧费用归集；MES：车间执行数据采集"},
        {"domain":"成本管理","capability":"成本核算管理","process":"产品成本核算基础管理","evidence":"GLTX-CW-01-A《财务成本核算管理程序》§5.2","system":"ERP、MES","basis":"ERP：仓库收发存、原始凭证管理；MES：车间物料移动和生产数据"},
        {"domain":"成本管理","capability":"成本核算管理","process":"月度产品成本核算与成本结转","evidence":"GLTX-CW-01-A《财务成本核算管理程序》§5.3-§5.4","system":"ERP","basis":"ERP：生产成本科目归集、制造费用分摊、完工入库成本结转、销售成本结转"},
        {"domain":"成本管理","capability":"成本核算管理","process":"成本费用核算分析","evidence":"GLTX-CW-01-A《财务成本核算管理程序》§5.6","system":"ERP","basis":"ERP：成本费用利润率分析、要素费用对比、差异分析报表"},
        {"domain":"成本管理","capability":"成本测算管理","process":"小时费率测算编制与维护","evidence":"GLTX-CW-06-A《成本测算管理程序》§5.1-§5.4、§5.9","system":"ERP、OA","basis":"ERP：设备台时/人工工时/制造费用分摊率测算；OA：费率审批与发布"},
        {"domain":"成本管理","capability":"成本测算管理","process":"产品全成本测算","evidence":"GLTX-CW-06-A《成本测算管理程序》§5.5-§5.8","system":"ERP","basis":"ERP：工序成本、废品损失、期间费用分摊、全成本测算与报价基础"},
        {"domain":"资产管理","capability":"固定资产管理","process":"固定资产编码与标签管理","evidence":"GLTX-CW-02-A《资产管理程序》§5.1","system":"ERP、OA","basis":"ERP：固定资产编码生成、资产台账；OA：标签打印申请"},
        {"domain":"资产管理","capability":"固定资产管理","process":"固定资产调拨管理","evidence":"GLTX-CW-02-A《资产管理程序》§5.1.3","system":"OA、ERP","basis":"OA：调拨申请、部门审核、归口审批；ERP：资产归属部门更新"},
        {"domain":"资产管理","capability":"固定资产管理","process":"固定资产盘点管理","evidence":"GLTX-CW-02-A《资产管理程序》§5.2","system":"OA、ERP","basis":"OA：盘点计划、盘点表签认、盘点报告审批；ERP：盘点结果账务处理"},
        {"domain":"资产管理","capability":"固定资产管理","process":"固定资产处置管理","evidence":"GLTX-CW-02-A《资产管理程序》§5.3","system":"OA、ERP","basis":"OA：闲置/报废申请、技术鉴定、多级审批；ERP：资产清理、销账"},
        {"domain":"资产管理","capability":"固定资产管理","process":"固定资产保险管理","evidence":"GLTX-CW-02-A《资产管理程序》§5.4","system":"OA","basis":"OA：投保申请、出险上报、理赔资料流转"},
        {"domain":"资产管理","capability":"无形资产管理","process":"无形资产全生命周期管理","evidence":"GLTX-CW-02-A《资产管理程序》§5.5","system":"OA、ERP","basis":"OA：保密协议、知识产权保护、专利申请审批；ERP：无形资产摊销核算、盘点"},
        {"domain":"资金管理","capability":"银行账户与存款管理","process":"银行账户开立、变更与撤销管理","evidence":"GLTX-CW-03-A《资金管理程序》§5.1","system":"OA、ERP","basis":"OA：开户/销户审批表、领导审批；ERP：账户主数据维护"},
        {"domain":"资金管理","capability":"银行账户与存款管理","process":"银行存款与网上银行管理","evidence":"GLTX-CW-03-A《资金管理程序》§5.3-§5.4","system":"ERP","basis":"ERP：银行对账、余额调节表、资金日记账；网银付款制单→复核→支付"},
        {"domain":"资金管理","capability":"现金与票据管理","process":"现金收付与库存管理","evidence":"GLTX-CW-03-A《资金管理程序》§5.2","system":"ERP","basis":"ERP：现金日记账、现金盘点表"},
        {"domain":"资金管理","capability":"现金与票据管理","process":"票据收取、开具与背书管理","evidence":"GLTX-CW-03-A《资金管理程序》§5.5","system":"ERP、OA","basis":"ERP：应收/应付票据台账；OA：票据业务审批"},
        {"domain":"资金管理","capability":"资金计划与备用金管理","process":"月度资金计划编制与执行管理","evidence":"GLTX-CW-03-A《资金管理程序》§5.6","system":"OA、ERP","basis":"OA：各部门计划报送、财务汇总审批；ERP：计划执行监控、收支分析"},
        {"domain":"资金管理","capability":"资金计划与备用金管理","process":"备用金借支与核销管理","evidence":"GLTX-CW-03-A《资金管理程序》§5.7","system":"OA、ERP","basis":"OA：备用金借支申请审批；ERP：备用金科目核算、工资扣回"},
        {"domain":"费用报销管理","capability":"差旅费管理","process":"出差申请与审批管理","evidence":"GLTX-CW-04-A《差旅费及报销管理程序》§5.1","system":"OA","basis":"OA：钉钉出差申请、审批流程、出差信息抄送"},
        {"domain":"费用报销管理","capability":"差旅费管理","process":"差旅费用报销管理","evidence":"GLTX-CW-04-A《差旅费及报销管理程序》§5.2","system":"OA、ERP","basis":"OA：差旅报销申请、限额控制、多级审批；ERP：费用入账、银行电汇付款"},
        {"domain":"费用报销管理","capability":"财务报销与付款管理","process":"报销与付款审批管理","evidence":"GLTX-CW-05-A《财务报销及付款管理程序》§5.1-§5.2","system":"OA、ERP","basis":"OA：七步审批流；ERP：付款执行与账务处理"},
        {"domain":"费用报销管理","capability":"财务报销与付款管理","process":"打车费报销专项管理","evidence":"GLTX-CW-05-A《财务报销及付款管理程序》§5.3","system":"OA","basis":"OA：钉钉公出申请→班组汇总→行政人事复核→财务审核→付款"}
      ];

      // ===== 业务行为（A1）数据（域详情视图）=====
      // [A1编号, 行为名称, 执行角色, 触发情景, 前置条件, 审批类型, 应用系统（S1）, 制度依据, 证据类型, 能力域（L1）, 业务能力（L2）, 业务流程（L3）, 核验提醒]
      var a1Rows = [
        // === 成本管理 - 成本核算管理 ===
        // CW-L3-01 生产成本定额管理与指标分解
        ["CW-L3-01-A01","接收研发项目完成后的技术方案与BOM单","财务部成本会计","研发项目完成，工程技术部提供技术方案和BOM单","研发项目已完成验收","无审批","ERP","GLTX-CW-01-A §5.1.1","上下文推断","成本管理","成本核算管理","生产成本定额管理与指标分解","请部门确认接收角色是否为成本会计"],
        ["CW-L3-01-A02","依据工时定额对订单成本进行预测","财务部成本会计","收到经营发展部制定的工时定额后","工时定额已由经营发展部制定并传递","无审批","ERP","GLTX-CW-01-A §5.1.1","上下文推断","成本管理","成本核算管理","生产成本定额管理与指标分解","请部门确认“订单成本预测”的具体执行岗位"],
        ["CW-L3-01-A03","分解并下达生产成本指标至生产部","财务部成本会计","订单成本预测完成后","订单成本预测已完成","单人审批","OA","GLTX-CW-01-A §5.1.2","上下文推断","成本管理","成本核算管理","生产成本定额管理与指标分解","原文§5.1.2主语为“生产部”负责分解下达，请部门确认财务部在指标分解下达中的角色"],
        // CW-L3-02 生产成本事中控制
        ["CW-L3-02-A01","监控物料消耗，按工艺单控制领料并管理退补料","财务部成本会计","生产过程中领料发生时","成本指标已分解下达","无审批","ERP、MES","GLTX-CW-01-A §5.1.2(1)","上下文推断","成本管理","成本核算管理","生产成本事中控制","请部门确认物料消耗监控角色"],
        ["CW-L3-02-A02","监控人工工时执行与工时调整审批","财务部成本会计","生产过程中工时异常需调整时","标准工时已设定","会签","OA","GLTX-CW-01-A §5.1.2(2)","原文明确-正文","成本管理","成本核算管理","生产成本事中控制","原文工时调整流程涉及车间工人→车间主任→定额员→经营发展部长，需确认财务部参与节点"],
