{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infomat.local/docs/contracts/document-structured-output.schema.json",
  "title": "文档结构化输出标准 Schema",
  "description": "用于统一制度、流程、表单、字段、证据和待确认问题的结构化输出合同。该合同不替代 docs/norms/ 流程输入基线，也不替代组织真源。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "draft",
    "document_profile",
    "processes",
    "steps",
    "evidence_catalog"
  ],
  "properties": {
    "schema_version": {
      "const": "document-structured-output-v1",
      "description": "当前合同版本。"
    },
    "generated_at": {
      "type": "string",
      "description": "结构化输出生成时间，建议使用 ISO 8601 字符串。"
    },
    "draft": {
      "$ref": "#/$defs/draft"
    },
    "document_profile": {
      "$ref": "#/$defs/documentProfile"
    },
    "terms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/term"
      },
      "default": []
    },
    "processes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/process"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "behavior_details": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/behaviorDetail"
      },
      "default": []
    },
    "cross_dept_handoffs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/crossDeptHandoff"
      },
      "default": []
    },
    "forms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/form"
      },
      "default": []
    },
    "form_tables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/formTable"
      },
      "default": []
    },
    "form_table_fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/formTableField"
      },
      "default": []
    },
    "form_fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/formField"
      },
      "default": []
    },
    "evidence_catalog": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "mdm_requirement_catalog": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mdmRequirement"
      },
      "default": []
    },
    "pending_issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pendingIssue"
      },
      "default": []
    },
    "structure_block_projection": {
      "$ref": "#/$defs/structureBlockProjection"
    },
    "markdown_draft": {
      "type": "string",
      "description": "面向人工复核的 Markdown 草案，仅为输出物，不作为字段解析主责。"
    }
  },
  "$defs": {
    "recordRef": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "integer"
        }
      ]
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    },
    "department": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "department_name"
      ],
      "properties": {
        "department_id": {
          "$ref": "#/$defs/recordRef"
        },
        "department_code": {
          "$ref": "#/$defs/nullableString"
        },
        "department_name": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "basisType": {
      "enum": [
        "现场实际",
        "制度 / 规程",
        "表单 / 台账",
        "会议 / 访谈",
        "暂无证据"
      ]
    },
    "draftStatus": {
      "enum": [
        "draft",
        "submitted",
        "under_review",
        "needs_changes",
        "approved",
        "published",
        "rejected"
      ]
    },
    "edition": {
      "type": "string",
      "pattern": "^[A-Z]+$",
      "description": "制度版次，由系统按 A、B、...、Z、AA、AB 自动生成。"
    },
    "versionStatus": {
      "enum": [
        "published",
        "superseded",
        "retired"
      ]
    },
    "processType": {
      "enum": [
        "new",
        "inherit",
        "handoff",
        "adjustment"
      ]
    },
    "processSystem": {
      "enum": [
        "",
        "OA",
        "MES",
        "PLM",
        "ERP"
      ]
    },
    "stepStatus": {
      "enum": [
        "active",
        "voided"
      ]
    },
    "handoffStatus": {
      "enum": [
        "pending_return",
        "returned",
        "pending_review",
        "confirmed"
      ]
    },
    "formStatus": {
      "enum": [
        "draft",
        "submitted",
        "published",
        "retired"
      ]
    },
    "tableKind": {
      "enum": [
        "main",
        "detail"
      ]
    },
    "fieldType": {
      "enum": [
        "文本",
        "长文本",
        "数字",
        "日期",
        "日期时间",
        "金额",
        "枚举",
        "布尔",
        "部门",
        "人员",
        "文件编号",
        "签名",
        "图片",
        "附件",
        "二维码"
      ]
    },
    "archiveLocation": {
      "enum": [
        "部门自行保存",
        "资料室"
      ]
    },
    "retentionPeriod": {
      "enum": [
        "1年",
        "3年",
        "10年",
        "永久"
      ]
    },
    "fieldStructureKind": {
      "enum": [
        "main",
        "detail"
      ]
    },
    "fieldStatus": {
      "enum": [
        "suggested",
        "business_confirmed",
        "data_governed",
        "published",
        "retired"
      ]
    },
    "evidenceType": {
      "enum": [
        "制度条款",
        "表单样例",
        "访谈记录",
        "会议纪要",
        "流程图",
        "台账记录",
        "暂无证据"
      ]
    },
    "evidenceStatus": {
      "enum": [
        "verified",
        "pending_review",
        "source_missing",
        "ocr_extracted_not_confirmed",
        "review_only"
      ]
    },
    "evidenceObjectType": {
      "enum": [
        "draft",
        "document_profile",
        "term",
        "process",
        "step",
        "behavior_detail",
        "handoff",
        "form",
        "form_table",
        "form_table_field",
        "form_field",
        "evidence",
        "mdm_requirement"
      ]
    },
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_no",
        "document_title",
        "planned_edition",
        "process_name",
        "basis_type",
        "department"
      ],
      "properties": {
        "draft_ref": {
          "$ref": "#/$defs/recordRef"
        },
        "document_no": {
          "type": "string",
          "minLength": 1
        },
        "document_title": {
          "type": "string",
          "minLength": 1
        },
        "planned_edition": {
          "$ref": "#/$defs/edition"
        },
        "current_edition": {
          "$ref": "#/$defs/nullableString"
        },
        "base_version_ref": {
          "$ref": "#/$defs/recordRef"
        },
        "process_name": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "basis_type": {
          "$ref": "#/$defs/basisType"
        },
        "basis_description": {
          "type": "string",
          "minLength": 1
        },
        "involves_other_departments": {
          "type": "boolean",
          "default": false
        },
        "related_departments": {
          "$ref": "#/$defs/stringList"
        },
        "department": {
          "$ref": "#/$defs/department"
        },
        "l1_name": {
          "$ref": "#/$defs/nullableString"
        },
        "l1_status": {
          "enum": [
            "unclassified",
            "needs_review",
            "confirmed"
          ]
        },
        "l2_name": {
          "$ref": "#/$defs/nullableString"
        },
        "l2_status": {
          "enum": [
            "unclassified",
            "needs_review",
            "confirmed"
          ]
        },
        "l3_name": {
          "$ref": "#/$defs/nullableString"
        },
        "status": {
          "$ref": "#/$defs/draftStatus"
        }
      },
      "x-mysql": {
        "table": "process_design_drafts"
      },
      "x-ui": {
        "section": "draft",
        "ids": [
          "pgDesignDocumentNo",
          "pgDesignDocumentTitle",
