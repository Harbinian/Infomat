{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infomat.local/contracts/process-governance-v7.schema.json",
  "title": "Infomat 单流程结构化文件规则 v7",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "export_meta",
    "process",
    "behaviors",
    "flow_relations",
    "data_objects",
    "forms",
    "terms",
    "migration"
  ],
  "properties": {
    "schema_version": { "const": "process-governance-v7" },
    "export_meta": { "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/exportMeta" },
    "process": { "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/process" },
    "behaviors": {
      "type": "array",
      "items": { "$ref": "#/$defs/behavior" },
      "default": []
    },
    "flow_relations": {
      "type": "array",
      "items": { "$ref": "#/$defs/flowRelation" },
      "default": []
    },
    "data_objects": {
      "type": "array",
      "items": { "$ref": "#/$defs/dataObject" },
      "default": []
    },
    "forms": {
      "type": "array",
      "items": { "$ref": "#/$defs/formOrRecord" },
      "default": []
    },
    "terms": {
      "type": "array",
      "items": { "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/term" },
      "default": []
    },
    "migration": { "$ref": "#/$defs/migration" }
  },
  "$defs": {
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "behavior_ref",
        "node_type",
        "behavior_name",
        "behavior_description",
        "current_actor_role",
        "actor_assignment_mode",
        "actor_department_data_ref",
        "actor_position_rule",
        "trigger",
        "precondition",
        "input_description",
        "timing",
        "completion_standard",
        "output_description",
        "countersign_all_required",
        "countersign_target_departments"
      ],
      "properties": {
        "behavior_ref": { "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/technicalRef" },
        "node_type": { "enum": ["", "action", "decision", "parallel_split", "parallel_join"] },
        "behavior_name": { "type": "string" },
        "behavior_description": { "type": "string" },
        "current_actor_role": { "type": "string" },
        "actor_assignment_mode": { "enum": ["fixed_department", "company_wide", "dynamic_from_data"] },
        "actor_department_data_ref": { "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/nullableTechnicalRef" },
        "actor_position_rule": { "type": "string" },
        "trigger": { "type": "string" },
        "precondition": { "type": "string" },
        "input_description": { "type": "string" },
        "timing": { "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/nullableString" },
        "completion_standard": { "type": "string" },
        "output_description": { "type": "string" },
        "countersign_all_required": { "type": "boolean" },
        "countersign_target_departments": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "default": []
        }
      }
    },
    "flowRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation_ref", "relation_type", "from_behavior_ref", "to_behavior_ref", "condition"],
      "properties": {
        "relation_ref": { "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/technicalRef" },
        "relation_type": { "enum": ["", "sequence", "condition", "loop", "parallel"] },
        "from_behavior_ref": { "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/nullableTechnicalRef" },
        "to_behavior_ref": { "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/nullableTechnicalRef" },
        "condition": { "type": "string" }
      }
    },
    "dataBehaviorLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["link_ref", "behavior_ref", "operation"],
      "properties": {
        "link_ref": { "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/technicalRef" },
        "behavior_ref": { "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/technicalRef" },
        "operation": { "enum": ["create", "update", "use", "pending_confirmation"] }
      }
    },
    "dataSourceRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ref",
        "source_department",
        "source_process_name",
        "source_behavior_name",
        "source_data_name",
        "availability_mode",
        "available_from_behavior_ref"
      ],
      "properties": {
        "source_ref": { "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/technicalRef" },
        "source_department": { "type": "string" },
        "source_process_name": { "type": "string" },
        "source_behavior_name": { "type": "string" },
        "source_data_name": { "type": "string" },
        "availability_mode": { "enum": ["process_start", "at_behavior", "pending_confirmation"] },
        "available_from_behavior_ref": { "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/nullableTechnicalRef" }
      }
    },
    "dataObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_ref", "data_name", "description", "information_type", "behavior_links", "source_relations", "lifecycle"],
      "properties": {
        "data_ref": { "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/technicalRef" },
        "data_name": { "type": "string" },
        "description": { "type": "string" },
        "information_type": {
          "enum": [
            "pending_confirmation",
            "business_information",
            "business_conclusion",
            "business_status",
            "identifier",
            "file_attachment",
            "other_information_output"
          ]
        },
        "behavior_links": { "type": "array", "items": { "$ref": "#/$defs/dataBehaviorLink" }, "default": [] },
        "source_relations": { "type": "array", "items": { "$ref": "#/$defs/dataSourceRelation" }, "default": [] },
        "lifecycle": { "$ref": "#/$defs/dataLifecycle" }
      }
    },
    "lifecycleState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["business_validity", "custody", "identifiability_applicability", "identifiability"],
      "properties": {
        "business_validity": {
          "enum": ["not_effective", "effective", "deactivated", "voided", "expired", "pending_confirmation"]
        },
        "custody": {
          "enum": ["active_custody", "archived", "destroyed", "pending_confirmation"]
        },
        "identifiability_applicability": {
          "enum": ["applicable", "not_applicable", "pending_confirmation"]
        },
        "identifiability": {
          "enum": ["identifiable", "irreversibly_anonymized", "not_applicable", "pending_confirmation"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "identifiability_applicability": { "const": "not_applicable" } },
            "required": ["identifiability_applicability"]
          },
          "then": { "properties": { "identifiability": { "const": "not_applicable" } } }
        },
        {
          "if": {
            "properties": { "identifiability_applicability": { "const": "applicable" } },
            "required": ["identifiability_applicability"]
          },
          "then": { "properties": { "identifiability": { "enum": ["identifiable", "irreversibly_anonymized", "pending_confirmation"] } } }
        }
      ]
    },
    "lifecycleTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "operator", "behavior_ref", "expression"],
      "properties": {
        "mode": { "enum": ["behavior", "time_period", "business_condition", "external_process_notice", "pending_confirmation"] },
        "operator": { "enum": ["single", "and", "or", "pending_confirmation"] },
        "behavior_ref": { "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/nullableTechnicalRef" },
        "expression": { "type": "string" }
      }
    },
    "lifecycleResponsibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "department", "position"],
      "properties": {
        "mode": { "enum": ["inherit_behavior", "explicit", "pending_confirmation"] },
        "department": { "type": "string" },
        "position": { "type": "string" }
      }
    },
    "lifecycleProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_ref", "source_path", "basis", "analyzer_version", "source_fingerprint"],
      "properties": {
        "source_type": { "enum": ["user_confirmed", "structured_relation", "behavior_description", "weak_keyword", "migration"] },
        "source_ref": { "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/nullableTechnicalRef" },
        "source_path": { "type": "string" },
        "basis": { "type": "string" },
        "analyzer_version": { "type": "string" },
        "source_fingerprint": { "type": "string" }
      }
    },
    "lifecycleEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_ref",
        "action",
        "trigger",
        "result_state",
        "target_scope",
        "carrier_scope",
        "responsibility",
        "exception_handling",
        "review_status",
        "high_risk",
        "decision_reason",
        "decision_notes",
        "provenance"
      ],
      "properties": {
        "event_ref": { "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/technicalRef" },
        "action": {
          "enum": ["activate", "deactivate", "reactivate", "void", "expire", "archive", "restore_active_custody", "destroy", "irreversible_anonymize"]
        },
        "trigger": { "$ref": "#/$defs/lifecycleTrigger" },
        "result_state": { "$ref": "#/$defs/lifecycleState" },
        "target_scope": { "enum": ["record", "version", "batch", "all_records", "pending_confirmation"] },
        "carrier_scope": { "enum": ["paper_original", "electronic_original", "business_copy", "paper_and_electronic", "not_applicable", "pending_confirmation"] },
        "responsibility": { "$ref": "#/$defs/lifecycleResponsibility" },
        "exception_handling": { "type": "string" },
        "review_status": { "enum": ["auto_generated", "pending_confirmation", "confirmed", "needs_recheck", "not_applicable", "rejected"] },
        "high_risk": { "type": "boolean" },
        "decision_reason": { "enum": ["", "source_not_applicable", "duplicate_suggestion", "semantic_mismatch", "insufficient_evidence", "conflicting_sources", "other"] },
        "decision_notes": { "type": "string" },
        "provenance": { "$ref": "#/$defs/lifecycleProvenance" }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              { "properties": { "action": { "enum": ["destroy", "irreversible_anonymize"] } }, "required": ["action"] },
              { "properties": { "target_scope": { "const": "all_records" } }, "required": ["target_scope"] }
            ]
          },
          "then": {
            "properties": {
              "high_risk": { "const": true },
              "review_status": { "enum": ["pending_confirmation", "confirmed", "needs_recheck", "not_applicable", "rejected"] }
            }
          }
        },
        {
          "if": {
            "properties": { "action": { "enum": ["archive", "restore_active_custody", "destroy"] } },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "carrier_scope": { "enum": ["paper_original", "electronic_original", "business_copy", "paper_and_electronic", "pending_confirmation"] }
            }
          },
          "else": { "properties": { "carrier_scope": { "const": "not_applicable" } } }
        },
        {
          "if": { "properties": { "action": { "enum": ["activate", "reactivate"] } }, "required": ["action"] },
          "then": { "properties": { "result_state": { "properties": { "business_validity": { "const": "effective" } } } } }
        },
        {
          "if": { "properties": { "action": { "const": "deactivate" } }, "required": ["action"] },
          "then": { "properties": { "result_state": { "properties": { "business_validity": { "const": "deactivated" } } } } }
        },
        {
          "if": { "properties": { "action": { "const": "void" } }, "required": ["action"] },
          "then": { "properties": { "result_state": { "properties": { "business_validity": { "const": "voided" } } } } }
        },
        {
          "if": { "properties": { "action": { "const": "expire" } }, "required": ["action"] },
          "then": { "properties": { "result_state": { "properties": { "business_validity": { "const": "expired" } } } } }
        },
        {
          "if": { "properties": { "action": { "const": "archive" } }, "required": ["action"] },
          "then": { "properties": { "result_state": { "properties": { "custody": { "const": "archived" } } } } }
        },
        {
          "if": { "properties": { "action": { "const": "restore_active_custody" } }, "required": ["action"] },
          "then": { "properties": { "result_state": { "properties": { "custody": { "const": "active_custody" } } } } }
        },
        {
          "if": { "properties": { "action": { "const": "destroy" } }, "required": ["action"] },
          "then": { "properties": { "result_state": { "properties": { "custody": { "const": "destroyed" } } } } }
        },
        {
          "if": { "properties": { "action": { "const": "irreversible_anonymize" } }, "required": ["action"] },
          "then": {
            "properties": {
              "result_state": {
                "properties": {
                  "identifiability_applicability": { "const": "applicable" },
                  "identifiability": { "const": "irreversibly_anonymized" }
                }
              }
            }
          }
        }
      ]
    },
    "lifecycleRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_ref", "route_label", "flow_relation_refs", "events", "exit_state"],
      "properties": {
        "route_ref": { "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/technicalRef" },
        "route_label": { "type": "string" },
        "flow_relation_refs": {
          "type": "array",
          "items": { "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/technicalRef" },
          "uniqueItems": true,
          "default": []
        },
        "events": { "type": "array", "items": { "$ref": "#/$defs/lifecycleEvent" }, "default": [] },
        "exit_state": { "$ref": "#/$defs/lifecycleState" }
      }
    },
    "lifecycleAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analyzer_version", "source_fingerprint", "status"],
      "properties": {
        "analyzer_version": { "type": "string" },
        "source_fingerprint": { "type": "string" },
        "status": { "enum": ["not_analyzed", "analyzed", "needs_recheck", "failed"] }
      }
    },
    "dataLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicability", "entry_state", "routes", "analysis", "decision_reason", "decision_notes"],
      "properties": {
        "applicability": { "enum": ["applicable", "not_applicable", "pending_confirmation"] },
        "entry_state": { "$ref": "#/$defs/lifecycleState" },
        "routes": { "type": "array", "items": { "$ref": "#/$defs/lifecycleRoute" }, "default": [] },
        "analysis": { "$ref": "#/$defs/lifecycleAnalysis" },
        "decision_reason": { "enum": ["", "no_lifecycle_in_current_process", "reference_only", "insufficient_evidence", "other"] },
        "decision_notes": { "type": "string" }
      }
    },
    "formBehaviorLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["link_ref", "behavior_ref", "operations", "notes"],
      "properties": {
        "link_ref": { "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/technicalRef" },
        "behavior_ref": { "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/technicalRef" },
        "operations": {
          "type": "array",
          "items": { "enum": ["create", "fill", "modify", "review", "approve", "confirm", "read", "archive", "void"] },
          "uniqueItems": true,
          "default": []
        },
        "notes": { "type": "string" }
      }
    },
    "fieldSourceLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_link_ref",
        "source_type",
        "source_data_ref",
        "source_system_name",
        "source_data_name",
        "source_role"
      ],
      "properties": {
        "source_link_ref": { "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/technicalRef" },
        "source_type": { "enum": ["process_data", "external_system"] },
        "source_data_ref": { "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/nullableTechnicalRef" },
        "source_system_name": { "type": "string" },
        "source_data_name": { "type": "string" },
        "source_role": { "enum": ["provides_value", "calculation_input", "validation_basis"] }
      },
      "allOf": [
        {
          "if": { "properties": { "source_type": { "const": "external_system" } }, "required": ["source_type"] },
          "then": { "properties": { "source_data_ref": { "type": "null" } } }
        }
      ]
    },
    "formItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_ref",
        "item_name",
        "item_type",
        "required",
        "instructions",
        "business_data_ref",
        "value_origin_mode",
        "source_links"
      ],
      "properties": {
        "item_ref": { "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/technicalRef" },
        "item_name": { "type": "string" },
        "item_type": { "type": "string" },
        "required": { "type": "boolean" },
        "instructions": { "type": "string" },
        "business_data_ref": { "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/nullableTechnicalRef" },
        "value_origin_mode": { "enum": ["direct_current_process", "depends_on_data", "pending_confirmation"] },
        "source_links": { "type": "array", "items": { "$ref": "#/$defs/fieldSourceLink" }, "default": [] }
      }
    },
    "formArea": {
      "type": "object",
      "additionalProperties": false,
      "required": ["area_ref", "area_type", "area_title", "items"],
      "properties": {
        "area_ref": { "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/technicalRef" },
        "area_type": { "enum": ["", "基本信息", "明细清单"] },
        "area_title": { "type": "string" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/formItem" }, "default": [] }
      }
    },
    "formOrRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["form_ref", "form_name", "form_no", "form_design_state", "behavior_links", "areas"],
      "properties": {
        "form_ref": { "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/technicalRef" },
        "form_name": { "type": "string" },
        "form_no": { "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/nullableString" },
        "form_design_state": { "enum": ["unspecified", "current_state", "proposed_design"] },
        "behavior_links": { "type": "array", "items": { "$ref": "#/$defs/formBehaviorLink" }, "default": [] },
        "areas": { "type": "array", "items": { "$ref": "#/$defs/formArea" }, "default": [] }
      }
    },
    "legacyCrossDepartmentRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_ref",
        "source_handoff",
        "conversion_status",
        "conversion_reason",
        "created_behavior_ref",
        "created_relation_refs",
        "created_data_link_refs"
      ],
      "properties": {
        "record_ref": { "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/technicalRef" },
        "source_handoff": { "$ref": "https://infomat.local/contracts/process-governance-v2.schema.json#/$defs/crossDepartmentHandoff" },
        "conversion_status": { "enum": ["converted", "needs_manual_completion"] },
        "conversion_reason": { "type": "string" },
        "created_behavior_ref": { "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/nullableTechnicalRef" },
        "created_relation_refs": {
          "type": "array",
          "items": { "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/technicalRef" },
          "uniqueItems": true,
          "default": []
        },
        "created_data_link_refs": {
          "type": "array",
          "items": { "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/technicalRef" },
          "uniqueItems": true,
          "default": []
        }
      }
    },
    "workRoleArchive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archive_ref", "behavior_ref", "original_behavior_name", "work_role"],
      "properties": {
        "archive_ref": { "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/technicalRef" },
        "behavior_ref": { "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/technicalRef" },
        "original_behavior_name": { "type": "string" },
        "work_role": { "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/workRole" }
      }
    },
    "unresolvedActorRole": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_ref",
        "behavior_ref",
        "raw_actor_role",
        "original_actor_assignment_mode",
        "source_schema_version",
        "reason"
      ],
      "properties": {
        "record_ref": { "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/technicalRef" },
        "behavior_ref": { "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/technicalRef" },
        "raw_actor_role": { "type": "string" },
        "original_actor_assignment_mode": { "type": "string" },
        "source_schema_version": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "unresolvedJoinMode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_ref", "relation_ref", "original_join_mode", "source_schema_version", "reason"],
      "properties": {
        "record_ref": { "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/technicalRef" },
        "relation_ref": { "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/technicalRef" },
        "original_join_mode": { "const": "all" },
        "source_schema_version": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_schema_version",
        "source_process_ref",
        "source_process_count",
        "legacy_cross_department_records",
        "reference_materials",
        "internal_process_calls",
        "work_roles",
        "unresolved_actor_roles",
        "unresolved_join_modes"
      ],
      "properties": {
