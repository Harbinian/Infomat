{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infomat.local/contracts/process-governance-v3.schema.json",
  "title": "Infomat 单流程结构化文件规则 v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "export_meta",
    "process",
    "reference_materials",
    "behaviors",
    "flow_relations",
    "data_objects",
    "cross_department_handoffs",
    "internal_process_calls",
    "forms",
    "terms"
  ],
  "properties": {
    "schema_version": {
      "const": "process-governance-v3"
    },
    "export_meta": {
      "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/exportMeta"
    },
    "process": {
      "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/process"
    },
    "reference_materials": {
      "type": "array",
      "items": {
        "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/referenceMaterial"
      },
      "default": []
    },
    "behaviors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/behavior"
      },
      "default": []
    },
    "flow_relations": {
      "type": "array",
      "items": {
        "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/flowRelation"
      },
      "default": []
    },
    "data_objects": {
      "type": "array",
      "items": {
        "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/dataObject"
      },
      "default": []
    },
    "cross_department_handoffs": {
      "type": "array",
      "items": {
        "$ref": "https://infomat.local/contracts/process-governance-v2.schema.json#/$defs/crossDepartmentHandoff"
      },
      "default": []
    },
    "internal_process_calls": {
      "type": "array",
      "items": {
        "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/internalProcessCall"
      },
      "default": []
    },
    "forms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/formOrRecord"
      },
      "default": []
    },
    "terms": {
      "type": "array",
      "items": {
        "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/term"
      },
      "default": []
    },
    "migration": {
      "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/migration"
    }
  },
  "$defs": {
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "behavior_ref",
        "node_type",
        "behavior_name",
        "current_actor_role",
        "trigger",
        "precondition",
        "input_description",
        "timing",
        "completion_standard",
        "output_description",
        "input_data_refs",
        "output_data_refs",
        "work_role",
        "countersign_all_required",
        "countersign_target_departments"
      ],
      "properties": {
        "behavior_ref": {
          "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/technicalRef"
        },
        "node_type": {
          "enum": [
            "",
            "action",
            "decision",
            "parallel_split",
            "parallel_join"
          ]
        },
        "behavior_name": {
          "type": "string"
        },
        "behavior_description": {
          "type": "string"
        },
        "current_actor_role": {
          "type": "string"
        },
        "actor_assignment_mode": {
          "enum": [
            "fixed_department",
            "company_wide",
            "dynamic_from_data"
          ],
          "default": "fixed_department"
        },
        "actor_department_data_ref": {
          "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/nullableTechnicalRef"
        },
        "actor_position_rule": {
          "type": "string"
        },
        "trigger": {
          "type": "string"
        },
        "precondition": {
          "type": "string"
        },
        "input_description": {
          "type": "string"
        },
        "timing": {
          "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/nullableString"
        },
        "completion_standard": {
          "type": "string"
        },
        "output_description": {
          "type": "string"
        },
        "input_data_refs": {
          "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/technicalRefList"
        },
        "output_data_refs": {
          "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/technicalRefList"
        },
        "work_role": {
          "anyOf": [
            {
              "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/workRole"
            },
            {
              "type": "null"
            }
          ]
        },
        "countersign_all_required": {
          "type": "boolean",
          "default": false
        },
        "countersign_target_departments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": []
        }
      }
    },
    "formOrRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "form_ref",
        "behavior_ref",
        "form_name",
        "form_no",
        "form_design_state",
        "areas"
      ],
      "properties": {
        "form_ref": {
          "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/technicalRef"
        },
        "behavior_ref": {
          "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/nullableTechnicalRef"
        },
        "form_name": {
          "type": "string"
        },
        "form_no": {
          "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/nullableString"
        },
        "form_design_state": {
          "enum": [
            "unspecified",
            "current_state",
            "proposed_design"
          ]
        },
        "areas": {
          "type": "array",
          "items": {
            "$ref": "https://infomat.local/contracts/process-governance-v1.schema.json#/$defs/formArea"
          },
          "default": []
        }
      }
    }
  }
}
